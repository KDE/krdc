msgstr ""
"Captura automàticament totes les tecles en entrar al mode de pantalla "
"completa i les deixa de capturar en sortir de la pantalla completa"

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_GrabAllKeysOnFullscreen)
#: config/general.ui:129
#, kde-format
msgid "Grab all keys when entering fullscreen"
msgstr "Captura totes les tecles en entrar a pantalla completa"

