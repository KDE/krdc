"Certificat anterior:\n"
"%1\n"
"Certificat nou:\n"
"%2"

#: rdp/rdpview.cpp:347
#, kde-format
msgctxt "@label"
msgid "The credentials for “%1” were not accepted."
msgstr "No s'han acceptat les credencials per a «%1»."

#: rdp/rdpview.cpp:350
#, kde-format
msgctxt "@info"
msgid "Check the RD Gateway credentials in the host settings."
msgstr ""
"Comproveu les credencials de RD Gateway a la configuració del servidor."

#: rdp/rdpview.cpp:366
#, kde-format
msgctxt "@label"
msgid "This account may not log in remotely."
msgstr "Aquest compte no pot iniciar sessió remotament."

#: rdp/rdpview.cpp:367
#, kde-format
msgctxt "@label"
msgid "“%1” may not log in remotely."
msgstr "«%1» no pot iniciar la sessió remotament."

#: rdp/rdpview.cpp:369
#, kde-format
msgctxt "@title connection error"
msgid "Access denied"
msgstr "S'ha denegat l'accés"

#: rdp/rdpview.cpp:371
#, kde-format
msgctxt "@info"
msgid "Check whether the account is locked, disabled or expired."
msgstr "Comproveu si el compte està bloquejat, desactivat o caducat."

#: rdp/rdpview.cpp:373
#, kde-format
msgctxt "@info"
msgid ""
"Ask the administrator of the remote computer to add the account to the "
"Remote Desktop Users group, or log in with a different account."
msgstr ""
"Demaneu a l'administrador de l'ordinador remot que afegeixi el compte al "
"grup d'usuaris d'escriptori remot o inicieu sessió amb un compte diferent."

#: rdp/rdpview.cpp:381
#, kde-format
msgctxt "@label"
msgid "The password must be changed before it can be used to log in remotely."
msgstr ""
"Cal canviar la contrasenya abans que es pugui utilitzar per iniciar sessió "
"remotament."

#: rdp/rdpview.cpp:382
#, kde-format
msgctxt "@title connection error"
msgid "Password expired"
msgstr "La contrasenya ha caducat"

#: rdp/rdpview.cpp:384
#, kde-format
msgctxt "@info"
msgid ""
"Change the password by logging in locally on the remote computer, or ask its "
"administrator to reset it."
msgstr ""
"Canvieu la contrasenya iniciant sessió localment a l'ordinador remot o "
"demaneu al seu administrador que la restableixi."

#: rdp/rdpview.cpp:389
#, kde-format
msgctxt "@label"
msgid "The Kerberos domain controller could not be reached."
msgstr "No s'ha pogut accedir al controlador del domini Kerberos."

#: rdp/rdpview.cpp:391
#, kde-format
msgctxt "@info"
msgid "Check the domain you entered when logging in."
msgstr "Comproveu el domini que heu introduït en iniciar sessió."

#: rdp/rdpview.cpp:392
#, kde-format
msgctxt "@info"
msgid "Connect to the network or VPN of the domain."
msgstr "Connecteu a la xarxa o VPN del domini."

#: rdp/rdpview.cpp:397 spice/spiceview.cpp:901 vnc/vncview.cpp:287
#, kde-format
msgctxt "@label"
msgid "No IP address was found for this name."
