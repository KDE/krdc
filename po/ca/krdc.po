#: core/connectionerror.cpp:15
#, kde-format
msgctxt "@info connection stage"
msgid "Setting up the SSH tunnel"
msgstr "Establiment del túnel SSH"

#: core/connectionerror.cpp:17
#, kde-format
msgctxt "@info connection stage"
msgid "Looking up the host name"
msgstr "S'està cercant el nom del servidor"

#: core/connectionerror.cpp:19
#, kde-format
msgctxt "@info connection stage"
msgid "Connecting to the server"
msgstr "S'està connectant amb el servidor"

#: core/connectionerror.cpp:21
#, kde-format
msgctxt "@info connection stage"
msgid "Securing the connection"
msgstr "S'està assegurant la connexió"

#: core/connectionerror.cpp:23
#, kde-format
msgctxt "@info connection stage"
msgid "Logging in"
msgstr "S'està iniciant la sessió"

#: core/connectionerror.cpp:25
#, kde-format
msgctxt "@info connection stage"
msgid "Starting the remote session"
msgstr "S'està iniciant la sessió remota"

#: core/connectionerror.cpp:27
#, kde-format
msgctxt "@info connection stage"
msgid "Connection interrupted"
msgstr "S'ha interromput la connexió"

#: core/connectionerror.cpp:29
#, kde-format
msgctxt "@info connection stage"
msgid "Session ended remotely"
msgstr "La sessió ha finalitzat remotament"

#: core/connectionerror.cpp:33
#, kde-format
msgctxt "@info connection stage"
msgid "Unknown"
msgstr "Desconegut"

#: core/connectionerror.cpp:45
#, kde-format
msgctxt "@title connection error"
msgid "SSH tunnel failed"
msgstr "Ha fallat el túnel SSH"

#: core/connectionerror.cpp:47
#, kde-format
msgctxt "@info"
msgid "Check the SSH tunnel user name and port in the host settings."
msgstr ""
"Comproveu el nom d'usuari i el port del túnel SSH a la configuració del "
"servidor."

#: core/connectionerror.cpp:48
#, kde-format
msgctxt "@info"
msgid ""
"Log in with an SSH client in a terminal to confirm that the server is "
"reachable and your credentials work."
msgstr ""
"Inicieu sessió amb un client SSH en un terminal per confirmar que el "
"servidor és accessible i que les vostres credencials funcionen."

#: core/connectionerror.cpp:49
#, kde-format
msgctxt "@info"
msgid ""
"If you use key authentication, add the key to your SSH agent with ssh-add."
msgstr ""
"Si utilitzeu l'autenticació amb clau, afegiu la clau al vostre agent SSH amb "
"«ssh-add»."

#: core/connectionerror.cpp:50
#, kde-format
msgctxt "@info"
msgid "Make sure the SSH server allows port forwarding."
msgstr "Assegureu-vos que el servidor SSH permet el reenviament de ports."

#: core/connectionerror.cpp:54
#, kde-format
msgctxt "@title connection error"
msgid "Server not found"
msgstr "No s'ha trobat el servidor"

#: core/connectionerror.cpp:56
#, kde-format
msgctxt "@info"
msgid "Check the spelling of the address."
msgstr "Comproveu l'ortografia de l'adreça."

#: core/connectionerror.cpp:57
#, kde-format
msgctxt "@info"
msgid "Connect to the network or VPN the computer is on."
msgstr "Connecteu a la xarxa o VPN on està l'ordinador."

#: core/connectionerror.cpp:58
#, kde-format
msgctxt "@info"
msgid "Try the IP address of the computer instead of its name."
msgstr "Proveu l'adreça IP de l'ordinador en lloc del seu nom."

#: core/connectionerror.cpp:63
#, kde-format
msgctxt "@title connection error"
msgid "Server not reachable"
msgstr "No es pot accedir al servidor"

#: core/connectionerror.cpp:65 core/connectionerror.cpp:145
#, kde-format
msgctxt "@info"
msgid ""
"Make sure the remote computer is turned on, awake and connected to the "
"network."
msgstr ""
"Assegureu-vos que l'ordinador remot està encès, despert i connectat a la "
"xarxa."

#: core/connectionerror.cpp:66 core/connectionerror.cpp:135
#, kde-format
msgctxt "@info"
msgid "Check that remote desktop sharing is enabled on the remote computer."
msgstr ""
"Comproveu que la compartició remota d'escriptori està activada a l'ordinador "
"remot."

#: core/connectionerror.cpp:67 core/connectionerror.cpp:136
#, kde-format
msgctxt "@info"
msgid ""
"Check the port in the address. The defaults are 3389 for RDP and 5900 for "
"VNC and SPICE."
msgstr ""
"Comproveu el port a l'adreça. Els valors predeterminats són 3389 per RDP i "
"5900 per VNC i SPICE."

#: core/connectionerror.cpp:68 core/connectionerror.cpp:146
#, kde-format
msgctxt "@info"
msgid "Check that no firewall blocks the connection."
msgstr "Comproveu que cap tallafoc bloquegi la connexió."

#: core/connectionerror.cpp:73
#, kde-format
msgctxt "@title connection error"
msgid "Secure connection failed"
msgstr "Ha fallat la connexió segura"

#: core/connectionerror.cpp:75
#, kde-format
msgctxt "@info"
msgid ""
"Review the security settings for this host, or reset them to their defaults."
msgstr ""
"Reviseu els paràmetres de seguretat d'aquest servidor o restabliu-los als "
"seus valors predeterminats."

#: core/connectionerror.cpp:76
#, kde-format
msgctxt "@info"
msgid ""
"If the server certificate changed unexpectedly, confirm the change with the "
"server administrator before accepting it."
msgstr ""
"Si el certificat del servidor ha canviat inesperadament, confirmeu el canvi "
"amb l'administrador del servidor abans d'acceptar-lo."

#: core/connectionerror.cpp:80
#, kde-format
msgctxt "@title connection error"
msgid "Authentication failed"
msgstr "Ha fallat en l'autenticació"

#: core/connectionerror.cpp:82
#, kde-format
msgctxt "@info"
msgid "Check the user name, password and domain, and that Caps Lock is off."
msgstr ""
"Comproveu el nom d'usuari, contrasenya i domini, i que el Bloq Maj estigui "
"desactivat."

#: core/connectionerror.cpp:83
#, kde-format
msgctxt "@info"
msgid "If you use a saved password, enter it again. It may be out of date."
msgstr ""
"Si utilitzeu una contrasenya desada, torneu-la a introduir. Pot estar "
"desfasada."

#: core/connectionerror.cpp:84
#, kde-format
msgctxt "@info"
msgid ""
"If the account is locked or expired, contact the administrator of the remote "
"computer."
msgstr ""
"Si el compte està bloquejat o caducat, poseu-vos en contacte amb "
"l'administrador de l'ordinador remot."

#: core/connectionerror.cpp:88
#, kde-format
msgctxt "@title connection error"
msgid "Session setup failed"
msgstr "Ha fallat l'establiment de la sessió"

#: core/connectionerror.cpp:90
#, kde-format
msgctxt "@info"
msgid ""
"Reset advanced options in the host settings, such as graphics acceleration "
"or color depth, to their defaults."
msgstr ""
"Restabliu les opcions avançades a la configuració del servidor, com ara "
"l'acceleració gràfica o la profunditat de color, als seus valors "
"predeterminats."

#: core/connectionerror.cpp:91
#, kde-format
msgctxt "@info"
msgid ""
"Ask the administrator of the remote computer whether new sessions are "
"allowed. The number of users may be limited."
msgstr ""
"Pregunteu a l'administrador de l'ordinador remot si es permeten sessions "
"noves. El nombre d'usuaris pot ser limitat."

#: core/connectionerror.cpp:96
#, kde-format
msgctxt "@title connection error"
msgid "Network connection interrupted"
msgstr "S'ha interromput la connexió de la xarxa"

#: core/connectionerror.cpp:98
#, kde-format
msgctxt "@info"
msgid "Check your network connection, then reconnect."
msgstr "Comproveu la vostra connexió de xarxa i torneu a connectar."

#: core/connectionerror.cpp:99
#, kde-format
msgctxt "@info"
msgid ""
"If the remote computer restarted or went to sleep, wait until it is back, "
"then reconnect."
msgstr ""
"Si l'ordinador remot s'ha reiniciat o s'ha anat a dormir, espereu fins que "
"estigui disponible i torneu a connectar."

#: core/connectionerror.cpp:104
#, kde-format
msgctxt "@title connection error"
msgid "Closed by the server"
msgstr "Tancada pel servidor"

#: core/connectionerror.cpp:109
#, kde-format
msgctxt "@title connection error"
msgid "Unexpected error"
msgstr "Error inesperat"

#: core/connectionerror.cpp:118
