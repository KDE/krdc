#: vnc/vncview.cpp:320
#, kde-format
msgctxt "@info"
msgid ""
"Wait a few minutes. The server blocks logins for a while after several "
"failed attempts."
msgstr ""
"נא להמתין מספר דקות. השרת חוסם כניסה למשך זמן מה לאחר כמה ניסיונות כושלים."

#: vnc/vncview.cpp:321
#, kde-format
msgctxt "@info"
msgid "Then connect again and enter the password carefully."
msgstr "לאחר מכן להתחבר שוב ולמלא את הסיסמה בקפידה."

