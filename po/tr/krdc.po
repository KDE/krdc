msgstr "Büyük (1280 × 1024)"

#. i18n: ectx: property (text), item, widget (KComboBox, resolutionComboBox)
#: vnc/vncpreferences.ui:113
#, kde-format
msgid "Very Large (1600x1200)"
msgstr "Çok büyük (1600 × 1200)"

#. i18n: ectx: property (text), widget (QCheckBox, dont_copy_passwords)
#: vnc/vncpreferences.ui:211
#, kde-format
msgid "Don't copy passwords from supported password managers to remote hosts"
msgstr ""
"Uzak makinelere, desteklenen parola yöneticilerinden parolaları kopyalama"

#. i18n: ectx: property (toolTip), widget (QCheckBox, dont_copy_passwords)
#: vnc/vncpreferences.ui:214
#, kde-format
msgid ""
"Supported password managers (like KeePassXC) mark copied passwords with an "
"additional MIME type \"x-kde-passwordManagerHint\" which is used for "
"filtering."
msgstr ""
"Desteklenen parola yöneticileri (örn. KeePassXC), kopyalanan parolaları "
"süzme için kullanılan bir ek “x-kde-passwordManagerHint” MIME türü ile imler."

#: vnc/vncview.cpp:255
#, kde-format
msgid "Access to the system requires a password."
msgstr "Bu sisteme erişim bir parola gerektiriyor."

#: vnc/vncview.cpp:255
#, kde-format
msgid "Authentication failed. Please try again."
msgstr ""
"Kimlik doğrulama başarısız oldu. Lütfen yeniden deneyin.Kimlik doğrulama "
"başarısız oldu."

#: vnc/vncview.cpp:306
#, kde-format
msgid "VNC authentication failed because of too many authentication tries."
msgstr "VNC kimlik doğrulaması çok fazla deneme yapıldığından başarısız oldu."

#: vnc/vncview.cpp:309
#, kde-format
msgctxt "@info"
msgid ""
"Wait a few minutes. The server blocks logins for a while after several "
"failed attempts."
msgstr ""
"Birkaç dakika bekleyin. Sunucu, birkaç başarısız deneme sonrası oturum "
"açmayı bir süre engelliyor olabilir."

#: vnc/vncview.cpp:310
#, kde-format
msgctxt "@info"
msgid "Then connect again and enter the password carefully."
msgstr "Sonrasında yeniden bağlanın ve parolayı dikkatlice girin."

#: vnc/vncview.cpp:316
#, kde-format
msgctxt "@label"
msgid ""
"The server requires an authentication method that KRDC does not support."
msgstr ""
"Sunucu, KRDC’nin desteklemediği bir kimlik doğrulama yöntemi gerektiriyor."

#: vnc/vncview.cpp:318
#, kde-format
msgctxt "@info"
msgid ""
"Configure the VNC server to use standard VNC password authentication, or "
"connect through an SSH tunnel."
msgstr ""
"VNC sunucusunu, standart VNC parola ile kimlik doğrulama yöntemini "
"kullanması için veya bir SSH tüneli aracılığıyla bağlanması için "
"yapılandırın."

