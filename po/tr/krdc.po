msgstr "<b>%1</b> konumuna bağlanmak için kimlik doğrulama gerekiyor."

#: spice/spiceview.cpp:892
#, kde-format
msgctxt "@label"
msgid "The TLS handshake failed."
msgstr "TLS el sıkışması yapılamadı."

#: spice/spiceview.cpp:893
#, kde-format
msgctxt "@info"
msgid ""
"Check whether the server accepts TLS only on a separate port, and that its "
"certificate is trusted."
msgstr ""
"Sunucunun TLS’yi yalnızca başka bir kapıda kabul edip etmediğini ve "
"sertifikasının güvenilir olup olmadığını denetleyin."

#: spice/spiceview.cpp:896
#, kde-format
msgctxt "@label"
msgid "The server rejected the SPICE connection."
msgstr "Sunucu, SPICE bağlantı isteğini geri çevirdi."

#: spice/spiceview.cpp:897
#, kde-format
msgctxt "@info"
msgid ""
"Check that this port belongs to a SPICE server with a compatible protocol "
"version."
msgstr ""
"Bu kapının, uyumlu bir protokol sürümüne sahip bir SPICE sunucusuna ait olup "
"olmadığını denetleyin."

#: spice/spiceview.cpp:907
#, kde-format
msgctxt "@info"
msgid ""
"Make sure the virtual machine is running, and its SPICE display listens on "
"this address."
msgstr ""
"Sanal makinenin çalışır durumda olduğundan ve SPICE ekranının bu adreste "
"dinleme yaptığından emin olun."

#: spice/spiceviewfactory.cpp:47
#, kde-format
