msgstr "Sunucu Yanıt Vermiyor"

#: core/connectionerror.cpp:147 core/connectionerror.cpp:156
#, kde-format
msgctxt "@info"
msgid "Check that the address is right."
msgstr "Adresin doğru olduğundan emin olun."

