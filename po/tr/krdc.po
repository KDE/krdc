#, kde-format
msgctxt "@info"
msgid ""
"If the remote computer restarted or went to sleep, wait until it is back, "
"then reconnect."
msgstr ""
"Uzak bilgisayar yeniden başlatılmış veya uykuya geçmişse geri gelene kadar "
"bekleyin ve sonra yeniden bağlanın."

#: core/connectionerror.cpp:104
#, kde-format
msgctxt "@title connection error"
