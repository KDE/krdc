#: rdp/rdpview.cpp:351
#, kde-format
msgctxt "@info"
msgid "Check the RD Gateway credentials in the host settings."
msgstr "Zkontrolujte přihlašovací údaje brány RD v nastavení hostitele."

#: rdp/rdpview.cpp:367
#, kde-format
msgctxt "@label"
msgid "This account may not log in remotely."
msgstr "Tento účet se nesmí přihlašovat vzdáleně."

#: rdp/rdpview.cpp:368
#, kde-format
msgctxt "@label"
msgid "“%1” may not log in remotely."
msgstr "\"%1\" se nemůže přihlásit vzdáleně."

#: rdp/rdpview.cpp:370
#, kde-format
msgctxt "@title connection error"
msgid "Access denied"
msgstr "Přístup odmítnut"

#: rdp/rdpview.cpp:372
#, kde-format
msgctxt "@info"
msgid "Check whether the account is locked, disabled or expired."
msgstr ""
"Zkontrolujte, zda je účet uzamčen, deaktivován nebo zda vypršela jeho "
"platnost."

#: rdp/rdpview.cpp:374
#, kde-format
msgctxt "@info"
msgid ""
"Ask the administrator of the remote computer to add the account to the "
"Remote Desktop Users group, or log in with a different account."
msgstr ""
"Požádejte správce vzdáleného počítače, aby tento účet přidal do skupiny "
"Uživatelé vzdálené plochy, nebo se přihlaste pomocí jiného účtu."

#: rdp/rdpview.cpp:382
#, kde-format
msgctxt "@label"
msgid "The password must be changed before it can be used to log in remotely."
msgstr ""
"Heslo je nutné změnit, než jej bude možné použít k vzdálenému přihlášení."

#: rdp/rdpview.cpp:383
#, kde-format
msgctxt "@title connection error"
msgid "Password expired"
msgstr "Platnost hesla vypršela"

#: rdp/rdpview.cpp:385
#, kde-format
msgctxt "@info"
msgid ""
"Change the password by logging in locally on the remote computer, or ask its "
"administrator to reset it."
msgstr ""
"Heslo změňte tak, že se přihlásíte lokálně na vzdáleném počítači, nebo "
"požádejte jeho správce, aby ho resetoval."

#: rdp/rdpview.cpp:390
#, kde-format
msgctxt "@label"
msgid "The Kerberos domain controller could not be reached."
msgstr "Nedařilo se navázat připojení s řadičem domény Kerberos."

#: rdp/rdpview.cpp:392
#, kde-format
msgctxt "@info"
msgid "Check the domain you entered when logging in."
msgstr "Zkontrolujte doménu, kterou jste zadali při přihlášení."

#: rdp/rdpview.cpp:393
#, kde-format
msgctxt "@info"
msgid "Connect to the network or VPN of the domain."
msgstr "Připojte se k síti nebo k VPN dané domény."

#: rdp/rdpview.cpp:398 spice/spiceview.cpp:901 vnc/vncview.cpp:287
#, kde-format
msgctxt "@label"
msgid "No IP address was found for this name."
msgstr "Pro tento název nebyla nalezena žádná IP adresa."

#: rdp/rdpview.cpp:409
#, kde-format
msgctxt "@label"
msgid "The server and KRDC could not agree on a security protocol."
msgstr "Server a KRDC se nedokázaly dohodnout na bezpečnostním protokolu."

#: rdp/rdpview.cpp:411
#, kde-format
msgctxt "@info"
msgid ""
"Set the TLS security level in the host settings to “Any”. The server may not "
"support the level selected."
msgstr ""
"V nastavení hostitele nastavte úroveň zabezpečení TLS na \"Cokoliv\". Server "
"nemusí podporovat vybranou úroveň."

#: rdp/rdpview.cpp:415
#, kde-format
msgctxt "@label"
msgid "The server requires Network Level Authentication (NLA)."
msgstr "Server vyžaduje ověřování na síťové úrovni (NLA)."

#: rdp/rdpview.cpp:416
#, kde-format
msgctxt "@info"
msgid "Enable NLA in the security settings for this host."
msgstr "V nastavení zabezpečení tohoto hostitele povolte funkci NLA."

#: rdp/rdpview.cpp:434
#, kde-format
msgctxt "@info"
msgid ""
"Check the RD Gateway settings for this host. The gateway “%1” may be "
"unreachable or reject the connection."
msgstr ""
"Zkontrolujte nastavení brány RD pro tohoto hostitele. Brána \"%1\" může být "
"nedostupná nebo může odmítat připojení."

#: rdp/rdpview.cpp:441
#, kde-format
msgctxt "@label"
msgid "The remote computer did not finish starting the session in time."
msgstr "Vzdálený počítač nestihl včas dokončit spuštění sezení."

#: rdp/rdpview.cpp:442
#, kde-format
msgctxt "@info"
msgid ""
"The remote computer may still be starting up or be under heavy load. Wait a "
"minute, then connect again."
msgstr ""
"Vzdálený počítač se možná ještě spouští nebo je silně vytížený. Počkejte "
"minutu a poté se připojte znovu."

#: rdp/rdpview.cpp:446
#, kde-format
msgctxt "@label"
msgid "It accepted the connection, then refused to start a session."
msgstr "Připojení bylo přijato, ale poté bylo odmítnuto zahájení sezení."

#: rdp/rdpview.cpp:447
#, kde-format
msgctxt "@title connection error"
msgid "Session refused"
msgstr "Sezení zamítnuto"

#: rdp/rdpview.cpp:451
#, kde-format
msgctxt "@label"
msgid "The server did not accept the options selected for this host."
msgstr "Server nepřijal volby vybrané pro tohoto hostitele."

#: rdp/rdpview.cpp:454
#, kde-format
msgctxt "@label"
msgid "An administrator or another program disconnected this session."
msgstr "Toto sezení ukončil správce nebo jiný program."

#: rdp/rdpview.cpp:457
#, kde-format
msgctxt "@label"
msgid "An administrator signed this session out."
msgstr "Správce ukončil toto sezení."

#: rdp/rdpview.cpp:460
#, kde-format
msgctxt "@label"
msgid "The session was disconnected from the remote computer."
msgstr "Připojení k vzdálenému počítači bylo přerušeno."

#: rdp/rdpview.cpp:467
#, kde-format
msgctxt "@label"
msgid "Disconnected because someone else connected to this session."
msgstr ""
"Připojení bylo přerušeno, protože se k tomuto sezení připojil někdo jiný."

#: rdp/rdpview.cpp:468
#, kde-format
msgctxt "@info"
msgid "Reconnect to take the session back. This disconnects the other user."
msgstr ""
"Znovu se připojte, abyste převzali sezení. Tím dojde k odpojení druhého "
"uživatele."

#: rdp/rdpview.cpp:471
#, kde-format
msgctxt "@label"
msgid "The session was closed after being idle for too long."
msgstr "Sezení bylo ukončeno z důvodu příliš dlouhé nečinnosti."

#: rdp/rdpview.cpp:472
#, kde-format
msgctxt "@info"
msgid ""
"Reconnect to continue. The idle time limit is set by the administrator of "
"the server."
msgstr ""
"Pro pokračování se znovu připojte. Časový limit nečinnosti nastavuje správce "
"serveru."

#: rdp/rdpview.cpp:486
#, kde-format
msgctxt "@label"
msgid "The remote computer reported a problem while logging in."
msgstr "Vzdálený počítač nahlásil problém při přihlašování."

#: rdp/rdpview.cpp:487
#, kde-format
msgctxt "@info"
msgid ""
"Check that this user may log in to the remote computer, and that the session "
"is not busy."
msgstr ""
"Ověřte, zda se tento uživatel může přihlásit ke vzdálenému počítači a zda "
"není sezení obsazeno."

