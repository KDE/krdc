msgid "Medium Quality (DSL, Cable, fast Internet)"
msgstr "Střední kvalita (DSL, rychlý Internet)"

#. i18n: ectx: property (text), item, widget (KComboBox, kcfg_Quality)
#: vnc/vncpreferences.ui:312
#, kde-format
msgid "Low Quality (Modem, ISDN, slow Internet)"
msgstr "Nízká kvalita (Modem, ISDN, pomalý Internet)"

#: vnc/vncview.cpp:255
#, kde-format
msgid "Access to the system requires a password."
msgstr "Přístup k systému vyžaduje heslo."

#: vnc/vncview.cpp:255
#, kde-format
msgid "Authentication failed. Please try again."
msgstr "Ověření selhalo. Prosím zkuste znovu."

#: vnc/vncview.cpp:306
#, kde-format
msgid "VNC authentication failed because of too many authentication tries."
msgstr "Ověření VNC selhalo z důvodu příliš mnoha neplatných pokusů."

#: vnc/vncview.cpp:309
#, kde-format
msgctxt "@info"
msgid ""
"Wait a few minutes. The server blocks logins for a while after several "
"failed attempts."
msgstr ""
"Počkejte pár minut. Server po několika neúspěšných pokusech o přihlášení na "
"chvíli přihlášení zablokuje."

#: vnc/vncview.cpp:310
#, kde-format
msgctxt "@info"
msgid "Then connect again and enter the password carefully."
msgstr "Poté se znovu připojte a pečlivě zadejte heslo."

#: vnc/vncview.cpp:316
#, kde-format
msgctxt "@label"
msgid ""
"The server requires an authentication method that KRDC does not support."
msgstr "Server vyžaduje metodu ověřování, kterou KRDC nepodporuje."

#: vnc/vncview.cpp:318
#, kde-format
msgctxt "@info"
msgid ""
"Configure the VNC server to use standard VNC password authentication, or "
"connect through an SSH tunnel."
msgstr ""
"Nastavte server VNC tak, aby používal standardní ověřování heslem VNC, nebo "
"se připojte přes tunel SSH."

#: vnc/vncviewfactory.cpp:47
#, kde-format
msgid "New VNC Connection…"
msgstr "Nové připojení VNC…"

#: vnc/vncviewfactory.cpp:52
#, kde-format
msgid "Connect to a VNC Remote Desktop"
msgstr "Připojit se na vzdálenou plochu VNC"

