#: core/sshtunnelthread.cpp:160 core/sshtunnelthread.cpp:168
#: core/sshtunnelthread.cpp:181
#, kde-format
msgid "Error creating tunnel socket"
msgstr "გვირაბის სოკეტის შექმნის შეცდომა"

