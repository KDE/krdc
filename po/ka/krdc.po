#: rdp/rdpview.cpp:273
#, kde-format
msgctxt "@title:dialog"
msgid "Verify Certificate"
msgstr "სერტიფიკატის გადამოწმება"

#: rdp/rdpview.cpp:278 rdp/rdpview.cpp:304
#, kde-format
msgctxt "@label"
msgid "Remember this certificate"
msgstr "ამ სერტიფიკატის დამახსოვრება"

#: rdp/rdpview.cpp:298
#, kde-format
msgctxt "@label"
msgid "The certificate for this system has changed. Do you wish to continue?"
msgstr "სერტიფიკატი ამ სისტემისთვის შეიცვალა. გნებავთ, გააგრძელოთ?"

#: rdp/rdpview.cpp:299
#, kde-format
msgctxt "@title:dialog"
msgid "Certificate has Changed"
msgstr "სერტიფიკატი შეიცვალა"

#: rdp/rdpview.cpp:302
#, kde-format
msgctxt "@label"
msgid ""
"Previous certificate:\n"
"%1\n"
"New Certificate:\n"
"%2"
msgstr ""
"წინა სერტიფიკატი:\n"
"%1\n"
"ახალი სერტიფიკატი:\n"
"%2"

#: rdp/rdpview.cpp:347
#, kde-format
msgctxt "@label"
msgid "The credentials for “%1” were not accepted."
msgstr "ავტორიზაციის დეტალები \"%1\"-ისთვის მიღებული არ იყო."

#: rdp/rdpview.cpp:350
#, kde-format
msgctxt "@info"
msgid "Check the RD Gateway credentials in the host settings."
msgstr "შეამოწმეთ RD კვანძის ავტორიზაციის დეტალები ჰოსტის მორგების ფანჯარაში."

#: rdp/rdpview.cpp:366
#, kde-format
msgctxt "@label"
msgid "This account may not log in remotely."
msgstr "ამ ანგარიშს დისტანციურად შესვლა არ შეუძლია."

#: rdp/rdpview.cpp:367
#, kde-format
msgctxt "@label"
msgid "“%1” may not log in remotely."
msgstr "“%1”-ს დისტანციურად შესვლა არ შეუძლია."

#: rdp/rdpview.cpp:369
#, kde-format
msgctxt "@title connection error"
msgid "Access denied"
msgstr "წვდომა აკრძალულია"

#: rdp/rdpview.cpp:371
#, kde-format
msgctxt "@info"
msgid "Check whether the account is locked, disabled or expired."
msgstr "შეამოწმეთ, ხომ არაა ანგარიში დაბლოკილი, გამორთული, ან ვადაგასული."

#: rdp/rdpview.cpp:373
#, kde-format
msgctxt "@info"
msgid ""
"Ask the administrator of the remote computer to add the account to the "
"Remote Desktop Users group, or log in with a different account."
msgstr ""
"სთხოვეთ დაშორებული კომპიუტერის ადმინისტრატორს, რომ დაამატოს ანგარიში "
"დაშორებული სამუშაო მაგიდის მომხმარებლების ჯგუფში, ან შედით სხვა ანგარიშით."

#: rdp/rdpview.cpp:381
#, kde-format
msgctxt "@label"
msgid "The password must be changed before it can be used to log in remotely."
msgstr "დაშორებულ კომპიუტერზე შესვლამდე აუცილებელია, პაროლი შეცვალოთ."

#: rdp/rdpview.cpp:382
#, kde-format
msgctxt "@title connection error"
msgid "Password expired"
msgstr "პაროლი ვადაგასულია"

#: rdp/rdpview.cpp:384
#, kde-format
msgctxt "@info"
msgid ""
"Change the password by logging in locally on the remote computer, or ask its "
"administrator to reset it."
msgstr ""
"შეცვალეთ პაროლი დაშორებულ მანქანაზე ლოკალურად შესვლით, ან სთხოვთ მის "
"ადმინისტრატორს, გააკეთოს ეს."

#: rdp/rdpview.cpp:389
#, kde-format
msgctxt "@label"
msgid "The Kerberos domain controller could not be reached."
msgstr "Kerberos-ის დომენის კონტროლერი ხელმისაწვდომი არაა."

#: rdp/rdpview.cpp:391
#, kde-format
msgctxt "@info"
msgid "Check the domain you entered when logging in."
msgstr "შეამოწმეთ რომელი, რომელიც შეიყვანეთ შესვლისას."

#: rdp/rdpview.cpp:392
#, kde-format
msgctxt "@info"
msgid "Connect to the network or VPN of the domain."
msgstr "დომენის ქსელთან, ან VPN-თან დაკავშირება."

#: rdp/rdpview.cpp:397 spice/spiceview.cpp:901 vnc/vncview.cpp:287
#, kde-format
msgctxt "@label"
msgid "No IP address was found for this name."
msgstr "ამ სახელისთვის IP მისამართი აღმოჩენილი არაა."

#: rdp/rdpview.cpp:408
#, kde-format
msgctxt "@label"
msgid "The server and KRDC could not agree on a security protocol."
msgstr "სერვერი და KRDC უსაფრთხოების პროტოკოლზე ვერ შეთანხმდნენ."

#: rdp/rdpview.cpp:410
#, kde-format
msgctxt "@info"
msgid ""
"Set the TLS security level in the host settings to “Any”. The server may not "
"support the level selected."
msgstr ""
"დააყენეთ TLS-ის უსაფრთხოების დონე ჰოსტის მორგების ფანჯარაში \"ნებისმიერზე\". "
"სერვერს, შეიძლება, არ ჰქონდეს არჩეული დონის მხარდაჭერა."

#: rdp/rdpview.cpp:414
#, kde-format
msgctxt "@label"
msgid "The server requires Network Level Authentication (NLA)."
msgstr "სერვერი ქსელური დონის ავთენტიკაციას (NLA) ითხოვს."

#: rdp/rdpview.cpp:415
#, kde-format
msgctxt "@info"
msgid "Enable NLA in the security settings for this host."
msgstr "ჩართეთ NLA ამ ჰოსტის მორგების ფანჯარაში."

#: rdp/rdpview.cpp:433
#, kde-format
msgctxt "@info"
msgid ""
"Check the RD Gateway settings for this host. The gateway “%1” may be "
"unreachable or reject the connection."
msgstr ""
"შეამოწმეთ RD კვანძის პარამეტრები ამ ჰოსტისთვის. კვანძი \"%1\", შეიძლება, "
"ხელმიუწვდომელია, ან უარჰყოფს კავშირს."

#: rdp/rdpview.cpp:440
#, kde-format
msgctxt "@label"
msgid "The remote computer did not finish starting the session in time."
msgstr "დაშორებულმა კომპიუტერმა სესიის დაწყება დროულად არ დაასრულა."

#: rdp/rdpview.cpp:441
#, kde-format
msgctxt "@info"
msgid ""
"The remote computer may still be starting up or be under heavy load. Wait a "
"minute, then connect again."
msgstr ""
"დაშორებული კომპიუტერი, შეიძლება, ჯერ კიდევ ეშვება, ან ძალიანაა დატვირთული. "
"მოითმინეთ რამდენიმე წუთი და დაუკავშირდით თავიდან."

#: rdp/rdpview.cpp:445
#, kde-format
msgctxt "@label"
msgid "It accepted the connection, then refused to start a session."
msgstr "მან მიიღო კავშირი, შემდეგ კი უარი თქვა სესიის დაწყებაზე."

#: rdp/rdpview.cpp:446
#, kde-format
msgctxt "@title connection error"
msgid "Session refused"
msgstr "სესია უარყოფილია"

#: rdp/rdpview.cpp:450
#, kde-format
msgctxt "@label"
msgid "The server did not accept the options selected for this host."
msgstr "სერვერმა არ მიიღო ამ ჰოსტისთვის არჩეული პარამეტრები."

#: rdp/rdpview.cpp:453
#, kde-format
msgctxt "@label"
msgid "An administrator or another program disconnected this session."
msgstr "ადმინისტრატორმა, ან სხვა პროგრამამ გათიშა ეს სესია."

#: rdp/rdpview.cpp:456
#, kde-format
msgctxt "@label"
msgid "An administrator signed this session out."
msgstr "ეს სესია ადმინისტრატორმა დაასრულა."

#: rdp/rdpview.cpp:459
#, kde-format
msgctxt "@label"
msgid "The session was disconnected from the remote computer."
msgstr "სესია გაითიშა დაშორებული კომპიუტერიდან."

#: rdp/rdpview.cpp:466
#, kde-format
msgctxt "@label"
msgid "Disconnected because someone else connected to this session."
msgstr "გაითიშა, რადგან ამ სესიას ვიღაც სხვა დაუკავშირდა."

#: rdp/rdpview.cpp:467
#, kde-format
msgctxt "@info"
msgid "Reconnect to take the session back. This disconnects the other user."
msgstr ""
"თავიდან დაკავშირება სესიას დაგიბრუნებთ, მაგრამ ეს გათიშავს სხვა მომხმარებელს."

#: rdp/rdpview.cpp:470
#, kde-format
msgctxt "@label"
msgid "The session was closed after being idle for too long."
msgstr "სესია დაიხურა დიდი ხნის განმავლობაში უქმეობის გამო."

#: rdp/rdpview.cpp:471
#, kde-format
msgctxt "@info"
msgid ""
"Reconnect to continue. The idle time limit is set by the administrator of "
"the server."
msgstr ""
"გასაგრძელებლად დაუკავშირდით თავიდან. უქმეობის დროის ლიმიტი სერვერის "
"ადმინისტრატორის მიერაა დაყენებული."

#: rdp/rdpview.cpp:485
#, kde-format
msgctxt "@label"
msgid "The remote computer reported a problem while logging in."
msgstr ""
"დაშორებულმა კომპიუტერმა გადმოგვცა ანგარიში შესვლისას აღმოჩენილი პრობლემის "
"შესახებ."

#: rdp/rdpview.cpp:486
#, kde-format
msgctxt "@info"
msgid ""
"Check that this user may log in to the remote computer, and that the session "
"is not busy."
msgstr ""
"შეამოწმეთ, რომ ამ მომხმარებელს შეუძლია დაშორებულ კომპიუტერზე შესვლა და რომ "
"სესია დაკავებული არაა."

