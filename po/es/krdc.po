msgstr "Introduzca la contraseña SSH."

#: core/remoteview.cpp:701
#, kde-format
msgctxt "@label"
msgid "The SSH tunnel on port %1 could not be set up."
msgstr "No se puede configurar el túnel SSH en el puerto %1."

