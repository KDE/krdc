#: rdp/rdpview.cpp:232
#, kde-format
msgctxt "@label"
msgid "Access to this system requires a username and password."
msgstr ""
"El acceso a este sistema necesita un nombre de usuario y una contraseña."

#: rdp/rdpview.cpp:272
#, kde-format
msgctxt "@label"
msgid "The certificate for this system is unknown. Do you wish to continue?"
msgstr "Se desconoce el certificado para este sistema. ¿Desea continuar?"

#: rdp/rdpview.cpp:273
#, kde-format
msgctxt "@title:dialog"
msgid "Verify Certificate"
msgstr "Verificar certificado"

#: rdp/rdpview.cpp:278 rdp/rdpview.cpp:304
#, kde-format
msgctxt "@label"
msgid "Remember this certificate"
msgstr "Recordar este certificado"

#: rdp/rdpview.cpp:298
#, kde-format
msgctxt "@label"
msgid "The certificate for this system has changed. Do you wish to continue?"
msgstr "El certificado para este sistema ha cambiado. ¿Desea continuar?"

#: rdp/rdpview.cpp:299
#, kde-format
msgctxt "@title:dialog"
msgid "Certificate has Changed"
msgstr "El certificado ha cambiado"

#: rdp/rdpview.cpp:302
#, kde-format
msgctxt "@label"
msgid ""
"Previous certificate:\n"
"%1\n"
"New Certificate:\n"
"%2"
msgstr ""
"Certificado anterior:\n"
"%1\n"
"Nuevo certificado:\n"
"%2"

#: rdp/rdpview.cpp:347
#, kde-format
msgctxt "@label"
msgid "The credentials for “%1” were not accepted."
msgstr "Las credenciales para «%1» no se han aceptado."

#: rdp/rdpview.cpp:350
#, kde-format
msgctxt "@info"
msgid "Check the RD Gateway credentials in the host settings."
msgstr ""
"Compruebe las credenciales de la puerta de enlace RD en los ajustes de la "
"máquina."

#: rdp/rdpview.cpp:366
#, kde-format
msgctxt "@label"
msgid "This account may not log in remotely."
msgstr "Esta cuenta no puede iniciar sesión remotamente."

#: rdp/rdpview.cpp:367
#, kde-format
msgctxt "@label"
msgid "“%1” may not log in remotely."
msgstr "«%1» no puede iniciar sesión remotamente."

#: rdp/rdpview.cpp:369
#, kde-format
msgctxt "@title connection error"
msgid "Access denied"
msgstr "Acceso denegado"

#: rdp/rdpview.cpp:371
#, kde-format
msgctxt "@info"
msgid "Check whether the account is locked, disabled or expired."
msgstr "Compruebe si la cuenta está bloqueada, desactivada o si ha expirado."

#: rdp/rdpview.cpp:373
#, kde-format
msgctxt "@info"
msgid ""
"Ask the administrator of the remote computer to add the account to the "
"Remote Desktop Users group, or log in with a different account."
msgstr ""
"Solicite al administrador del equipo remoto que añada la cuenta al grupo de "
"usuarios de escritorio remoto, o inicie sesión con otra cuenta."

#: rdp/rdpview.cpp:381
#, kde-format
msgctxt "@label"
msgid "The password must be changed before it can be used to log in remotely."
msgstr ""
"Debe cambiar la contraseña antes de usarla para iniciar sesión remotamente."

#: rdp/rdpview.cpp:382
#, kde-format
msgctxt "@title connection error"
msgid "Password expired"
msgstr "La contraseña ha expirado"

#: rdp/rdpview.cpp:384
#, kde-format
msgctxt "@info"
msgid ""
"Change the password by logging in locally on the remote computer, or ask its "
"administrator to reset it."
msgstr ""
"Cambie la contraseña iniciando sesión localmente en el equipo remoto o "
"solicite a su administrador que la restablezca."

#: rdp/rdpview.cpp:389
#, kde-format
msgctxt "@label"
msgid "The Kerberos domain controller could not be reached."
msgstr "No se puede acceder al controlador de dominio Kerberos."

#: rdp/rdpview.cpp:391
#, kde-format
msgctxt "@info"
msgid "Check the domain you entered when logging in."
msgstr "Compruebe el dominio que ha introducido al iniciar sesión."

#: rdp/rdpview.cpp:392
#, kde-format
msgctxt "@info"
msgid "Connect to the network or VPN of the domain."
msgstr "Conéctese a la red o a la VPN del dominio."

#: rdp/rdpview.cpp:397 spice/spiceview.cpp:901 vnc/vncview.cpp:287
#, kde-format
msgctxt "@label"
msgid "No IP address was found for this name."
msgstr "No se ha encontrado ninguna dirección IP para este nombre."

#: rdp/rdpview.cpp:408
#, kde-format
msgctxt "@label"
msgid "The server and KRDC could not agree on a security protocol."
msgstr ""
"El servidor y KRDC no han logrado ponerse de acuerdo sobre un protocolo de "
"seguridad."

#: rdp/rdpview.cpp:410
#, kde-format
msgctxt "@info"
msgid ""
"Set the TLS security level in the host settings to “Any”. The server may not "
"support the level selected."
msgstr ""
"Defina el nivel de seguridad TLS en los ajustes de la máquina a "
"«Cualquiera». Es posible que el servidor no permita el nivel seleccionado."

#: rdp/rdpview.cpp:414
#, kde-format
msgctxt "@label"
msgid "The server requires Network Level Authentication (NLA)."
msgstr "El servidor requiere autenticación a nivel de red (NLA)."

#: rdp/rdpview.cpp:415
#, kde-format
msgctxt "@info"
msgid "Enable NLA in the security settings for this host."
msgstr "Active NLA en los ajustes de seguridad de esta máquina."

#: rdp/rdpview.cpp:433
#, kde-format
msgctxt "@info"
msgid ""
"Check the RD Gateway settings for this host. The gateway “%1” may be "
"unreachable or reject the connection."
msgstr ""
"Compruebe los ajustes de la puerta de enlace RD para esta máquina. Es "
"posible que no se pueda acceder a la puerta de enlace «%1» o que se rechace "
"la conexión."

#: rdp/rdpview.cpp:440
#, kde-format
msgctxt "@label"
msgid "The remote computer did not finish starting the session in time."
msgstr "El equipo remoto no ha terminado de iniciar la sesión a tiempo."

#: rdp/rdpview.cpp:441
#, kde-format
msgctxt "@info"
msgid ""
"The remote computer may still be starting up or be under heavy load. Wait a "
"minute, then connect again."
msgstr ""
"Es posible que el equipo remoto aún esté arrancando o que tenga una carga de "
"trabajo elevada. Espere un minuto y vuelva a conectarse."

#: rdp/rdpview.cpp:445
#, kde-format
msgctxt "@label"
msgid "It accepted the connection, then refused to start a session."
msgstr "Ha aceptado la conexión y luego ha rechazado el inicio de sesión."

#: rdp/rdpview.cpp:446
#, kde-format
msgctxt "@title connection error"
msgid "Session refused"
msgstr "Sesión rechazada"

#: rdp/rdpview.cpp:450
#, kde-format
msgctxt "@label"
msgid "The server did not accept the options selected for this host."
msgstr ""
"El servidor ho ha aceptado las opciones seleccionadas para esta máquina."

#: rdp/rdpview.cpp:453
#, kde-format
msgctxt "@label"
msgid "An administrator or another program disconnected this session."
msgstr "Un administrador o un programa ha desconectado esta sesión."

#: rdp/rdpview.cpp:456
#, kde-format
msgctxt "@label"
msgid "An administrator signed this session out."
msgstr "Un administrador ha cerrado esta sesión."

#: rdp/rdpview.cpp:459
#, kde-format
msgctxt "@label"
msgid "The session was disconnected from the remote computer."
msgstr "La sesión se ha desconectado del equipo remoto."

#: rdp/rdpview.cpp:466
#, kde-format
msgctxt "@label"
msgid "Disconnected because someone else connected to this session."
msgstr "Desconectado porque otra persona se ha conectado a esta sesión."

#: rdp/rdpview.cpp:467
#, kde-format
msgctxt "@info"
msgid "Reconnect to take the session back. This disconnects the other user."
msgstr ""
"Vuelva a conectarse para retomar la sesión. Esto desconectará al otro "
"usuario."

#: rdp/rdpview.cpp:470
#, kde-format
msgctxt "@label"
msgid "The session was closed after being idle for too long."
msgstr ""
"Se ha cerrado la conexión tras haber estado inactiva durante mucho tiempo."

#: rdp/rdpview.cpp:471
#, kde-format
msgctxt "@info"
msgid ""
"Reconnect to continue. The idle time limit is set by the administrator of "
"the server."
msgstr ""
"Vuelva a conectarse para continuar. El límite del tiempo de inactividad está "
"definido por el administrador del servidor."

#: rdp/rdpview.cpp:485
#, kde-format
msgctxt "@label"
msgid "The remote computer reported a problem while logging in."
msgstr ""
"El equipo remoto ha informado de un problema durante el inicio de sesión."

#: rdp/rdpview.cpp:486
#, kde-format
msgctxt "@info"
msgid ""
"Check that this user may log in to the remote computer, and that the session "
"is not busy."
msgstr ""
"Compruebe que este usuario puede iniciar sesión en el equipo remoto y que la "
"sesión no esté ocupada."

