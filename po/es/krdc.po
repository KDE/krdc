#, kde-format
msgctxt "@title connection error"
msgid "SSH server not reachable"
msgstr "Servidor SSH no accesible"

#: core/remoteview.cpp:705
#, kde-format
msgctxt "@label"
msgid "The SSH server did not accept a connection on port %1."
msgstr "El servidor SSH no ha aceptado una conexión en el puerto %1."

#: core/remoteview.cpp:707
#, kde-format
msgctxt "@info"
msgid "Make sure the SSH server is running and listens on port %1."
msgstr ""
"Asegúrese de que el servidor SSH esté funcionando y escuchando en el puerto "
"%1."

#: core/remoteview.cpp:708
#, kde-format
msgctxt "@info"
msgid ""
"Check the host name, and that the computer is reachable from this network."
msgstr ""
"Compruebe el nombre de máquina y que se puede acceder a dicho equipo desde "
"esta red."

#: core/remoteview.cpp:709
#, kde-format
msgctxt "@info"
msgid "Check that no firewall blocks SSH connections."
msgstr "Compruebe que ningún cortafuegos bloquea las conexiones SSH."

#: core/remoteview.cpp:713
#, kde-format
msgctxt "@title connection error"
msgid "SSH login failed"
msgstr "El inicio de sesión SSH ha fallado"

#: core/remoteview.cpp:714
#, kde-format
msgctxt "@label"
msgid "The SSH server did not accept the login."
msgstr "El servidor SSH no ha aceptado el inicio de sesión."

#: core/remoteview.cpp:715
#, kde-format
msgctxt "@label"
msgid "The SSH server did not accept the login for “%1”."
msgstr "El servidor SSH no ha aceptado el inicio de sesión para «%1»."

#: core/remoteview.cpp:717
#, kde-format
msgctxt "@info"
msgid "Check the SSH user name in the host settings, and the password."
msgstr ""
"Compruebe el nombre de usuario SSH y la contraseña en los ajustes de la "
"máquina."

#: core/remoteview.cpp:718
#, kde-format
msgctxt "@info"
msgid ""
"If you use key authentication, add the key to your SSH agent with ssh-add, "
"and make sure it is authorized on the server."
msgstr ""
"Si usa autenticación mediante clave, añada la clave al agente SSH con «ssh-"
"add» y asegúrese de que está autorizada en el servidor."

#: core/remoteview.cpp:719
#, kde-format
msgctxt "@info"
msgid ""
"If the SSH server does not allow password logins, set up key authentication."
msgstr ""
"Si el servidor SSH no permite inicios de sesión mediante contraseña, "
"configure la autenticación mediante clave."

#: core/remoteview.cpp:723
#, kde-format
msgctxt "@label"
msgid "No free local port could be opened for the tunnel on this computer."
msgstr ""
"No se puede abrir ningún puerto local libre de este equipo para el túnel."

#: core/remoteview.cpp:725
#, kde-format
msgctxt "@info"
msgid ""
"Close other applications that open many network connections, then connect "
"again."
msgstr ""
"Cierre las aplicaciones que abren muchas conexiones de red y vuelva a "
"conectarse."

