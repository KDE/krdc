msgstr ""
"Capturar todas las pulsaciones automáticamente al entrar en el modo de "
"pantalla completa y liberarlas al salir de él"

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_GrabAllKeysOnFullscreen)
#: config/general.ui:129
#, kde-format
msgid "Grab all keys when entering fullscreen"
msgstr "Capturar todas las pulsaciones al cambiar a pantalla completa"

