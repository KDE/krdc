#: core/connectionerror.cpp:15
#, kde-format
msgctxt "@info connection stage"
msgid "Setting up the SSH tunnel"
msgstr "Configurando el túnel SSH"

#: core/connectionerror.cpp:17
#, kde-format
msgctxt "@info connection stage"
msgid "Looking up the host name"
msgstr "Buscando el nombre de máquina"

#: core/connectionerror.cpp:19
#, kde-format
msgctxt "@info connection stage"
msgid "Connecting to the server"
msgstr "Conectando al servidor"

#: core/connectionerror.cpp:21
#, kde-format
msgctxt "@info connection stage"
msgid "Securing the connection"
msgstr "Asegurando la conexión"

#: core/connectionerror.cpp:23
#, kde-format
msgctxt "@info connection stage"
msgid "Logging in"
msgstr "Iniciando sesión"

#: core/connectionerror.cpp:25
#, kde-format
msgctxt "@info connection stage"
msgid "Starting the remote session"
msgstr "Iniciando la sesión remota"

#: core/connectionerror.cpp:27
#, kde-format
msgctxt "@info connection stage"
msgid "Connection interrupted"
msgstr "Conexión interrumpida"

#: core/connectionerror.cpp:29
#, kde-format
msgctxt "@info connection stage"
msgid "Session ended remotely"
msgstr "Sesión finalizada remotamente"

#: core/connectionerror.cpp:33
#, kde-format
msgctxt "@info connection stage"
msgid "Unknown"
msgstr "Desconocida"

#: core/connectionerror.cpp:45
#, kde-format
msgctxt "@title connection error"
msgid "SSH tunnel failed"
msgstr "El túnel SSH ha fallado"

#: core/connectionerror.cpp:47
#, kde-format
msgctxt "@info"
msgid "Check the SSH tunnel user name and port in the host settings."
msgstr ""
"Compruebe el nombre de usuario y el puerto del túnel SSH en los ajustes de "
"la máquina."

#: core/connectionerror.cpp:48
#, kde-format
msgctxt "@info"
msgid ""
"Log in with an SSH client in a terminal to confirm that the server is "
"reachable and your credentials work."
msgstr ""
"Inicie sesión con un cliente SSH en una terminal para confirmar que se puede "
"acceder al servidor y que las credenciales son correctas."

#: core/connectionerror.cpp:49
#, kde-format
msgctxt "@info"
msgid ""
"If you use key authentication, add the key to your SSH agent with ssh-add."
msgstr ""
"Si usa autenticación mediante clave, añada la clave al agente SSH con `ssh-"
"add`."

#: core/connectionerror.cpp:50
#, kde-format
msgctxt "@info"
msgid "Make sure the SSH server allows port forwarding."
msgstr "Asegúrese de que el servidor SSH permite reenvío de puertos."

#: core/connectionerror.cpp:54
#, kde-format
msgctxt "@title connection error"
msgid "Server not found"
msgstr "Servidor no encontrado"

#: core/connectionerror.cpp:56
#, kde-format
msgctxt "@info"
msgid "Check the spelling of the address."
msgstr "Compruebe la sintaxis de la dirección."

#: core/connectionerror.cpp:57
#, kde-format
msgctxt "@info"
msgid "Connect to the network or VPN the computer is on."
msgstr "Conéctese a la red o VPN en la que se encuentra el equipo."

#: core/connectionerror.cpp:58
#, kde-format
msgctxt "@info"
msgid "Try the IP address of the computer instead of its name."
msgstr "Pruebe con la dirección IP del equipo en lugar de su nombre."

#: core/connectionerror.cpp:63
#, kde-format
msgctxt "@title connection error"
msgid "Server not reachable"
msgstr "Servidor no accesible"

#: core/connectionerror.cpp:65 core/connectionerror.cpp:145
#, kde-format
msgctxt "@info"
msgid ""
"Make sure the remote computer is turned on, awake and connected to the "
"network."
msgstr ""
"Asegúrese de que el equipo remoto está encendido, activo y conectado a la "
"red."

#: core/connectionerror.cpp:66 core/connectionerror.cpp:135
#, kde-format
msgctxt "@info"
msgid "Check that remote desktop sharing is enabled on the remote computer."
msgstr ""
"Comprueba que el uso compartido de escritorio remoto está activado en el "
"equipo remoto."

#: core/connectionerror.cpp:67 core/connectionerror.cpp:136
#, kde-format
msgctxt "@info"
msgid ""
"Check the port in the address. The defaults are 3389 for RDP and 5900 for "
"VNC and SPICE."
msgstr ""
"Compruebe el puerto de la dirección. Los predeterminados son el 3389 para "
"RDP y el 5900 para VNC y SPICE."

#: core/connectionerror.cpp:68 core/connectionerror.cpp:146
#, kde-format
msgctxt "@info"
msgid "Check that no firewall blocks the connection."
msgstr "Compruebe que ningún cortafuegos esté bloqueando la conexión."

#: core/connectionerror.cpp:73
#, kde-format
msgctxt "@title connection error"
msgid "Secure connection failed"
msgstr "La conexión segura ha fallado"

#: core/connectionerror.cpp:75
#, kde-format
msgctxt "@info"
msgid ""
"Review the security settings for this host, or reset them to their defaults."
msgstr ""
"Revise los ajustes de seguridad para esta máquina o restaure sus valores "
"predeterminados."

#: core/connectionerror.cpp:76
#, kde-format
msgctxt "@info"
msgid ""
"If the server certificate changed unexpectedly, confirm the change with the "
"server administrator before accepting it."
msgstr ""
"Si el certificado del servidor ha cambiado de forma inesperada, confirme el "
"cambio con el administrador del servidor antes de aceptarlo."

#: core/connectionerror.cpp:80
#, kde-format
msgctxt "@title connection error"
msgid "Authentication failed"
msgstr "La autenticación ha fallado"

#: core/connectionerror.cpp:82
#, kde-format
msgctxt "@info"
msgid "Check the user name, password and domain, and that Caps Lock is off."
msgstr ""
"Compruebe el nombre de usuario, la contraseña y el dominio, y que el bloqueo "
"de mayúsculas está desactivado."

#: core/connectionerror.cpp:83
#, kde-format
msgctxt "@info"
msgid "If you use a saved password, enter it again. It may be out of date."
msgstr ""
"Si usa una contraseña guardada, vuelva a introducirla. Es posible que esté "
"desactualizada."

#: core/connectionerror.cpp:84
#, kde-format
msgctxt "@info"
msgid ""
"If the account is locked or expired, contact the administrator of the remote "
"computer."
msgstr ""
"Si la cuenta está bloqueada o ha caducado, póngase en contacto con el "
"administrador del equipo remoto."

#: core/connectionerror.cpp:88
#, kde-format
msgctxt "@title connection error"
msgid "Session setup failed"
msgstr "La configuración de la sesión ha fallado"

#: core/connectionerror.cpp:90
#, kde-format
msgctxt "@info"
msgid ""
"Reset advanced options in the host settings, such as graphics acceleration "
"or color depth, to their defaults."
msgstr ""
"Restaure los valores predeterminados de las opciones avanzadas en los "
"ajustes de la máquina, como la aceleración gráfica o la profundidad de color."

#: core/connectionerror.cpp:91
#, kde-format
msgctxt "@info"
msgid ""
"Ask the administrator of the remote computer whether new sessions are "
"allowed. The number of users may be limited."
msgstr ""
"Pregunte al administrador del equipo remoto si se permiten nuevas sesiones. "
"El número de usuarios puede estar limitado."

#: core/connectionerror.cpp:96
#, kde-format
msgctxt "@title connection error"
msgid "Network connection interrupted"
msgstr "Conexión de red interrumpida"

#: core/connectionerror.cpp:98
#, kde-format
msgctxt "@info"
msgid "Check your network connection, then reconnect."
msgstr "Compruebe la conexión de red y vuelva a conectar."

#: core/connectionerror.cpp:99
#, kde-format
msgctxt "@info"
msgid ""
"If the remote computer restarted or went to sleep, wait until it is back, "
"then reconnect."
msgstr ""
"Si el equipo remoto se ha reiniciado o está en reposo, espere hasta que "
"vuelva a estar activo y vuelva a conectar."

#: core/connectionerror.cpp:104
#, kde-format
msgctxt "@title connection error"
msgid "Closed by the server"
msgstr "Cerrada por el servidor"

#: core/connectionerror.cpp:109
#, kde-format
msgctxt "@title connection error"
msgid "Unexpected error"
msgstr "Error inesperado"

#: core/connectionerror.cpp:118
#, kde-format
msgctxt "@label"
msgid "It accepted the connection, then closed it before the session started."
msgstr ""
"Se ha aceptado la conexión y luego se ha cerrado antes de iniciar la sesión."

#: core/connectionerror.cpp:119
#, kde-format
msgctxt "@title connection error"
msgid "Server closed the connection"
msgstr "El servidor ha cerrado la conexión"

#: core/connectionerror.cpp:121
#, kde-format
msgctxt "@info"
msgid ""
"If another viewer is connected, close it. Some servers allow only one at a "
"time."
msgstr ""
"Si tiene conectado otro visor, ciérrelo. Algunos servidores solo permiten "
"uno a la vez."

#: core/connectionerror.cpp:122
#, kde-format
msgctxt "@info"
msgid "Check that this port belongs to the remote desktop service you expect."
msgstr ""
"Compruebe que este puerto pertenece al servicio de escritorio remoto que se "
"espera."

#: core/connectionerror.cpp:123
#, kde-format
msgctxt "@info"
msgid ""
"Check the access and security settings of the server, or its log, for why it "
"closed the connection."
msgstr ""
"Compruebe los ajustes de acceso y de seguridad del servidor o su registro "
"para saber por qué ha cerrado la conexión."

#: core/connectionerror.cpp:133
#, kde-format
msgctxt "@title connection error"
msgid "Connection refused"
msgstr "Conexión rechazada"

#: core/connectionerror.cpp:137
#, kde-format
msgctxt "@info"
msgid "Check that no firewall on the remote computer rejects the connection."
msgstr ""
"Compruebe que ningún cortafuegos del equipo remoto rechace la conexión."

#: core/connectionerror.cpp:143
#, kde-format
msgctxt "@title connection error"
msgid "Server not responding"
msgstr "El servidor no responde"

#: core/connectionerror.cpp:147 core/connectionerror.cpp:156
#, kde-format
msgctxt "@info"
msgid "Check that the address is right."
msgstr "Compruebe que la dirección es correcta."

