#, kde-format
msgctxt "@title connection error"
msgid "No route to the server"
msgstr "No se encuentra la ruta hasta el servidor"

#: core/connectionerror.cpp:155
#, kde-format
msgctxt "@info"
msgid "Connect to the network or VPN the remote computer is on."
msgstr "Conéctese a la red o a la VPN en la que se encuentra el equipo remoto."

