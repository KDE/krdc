msgstr "Помилка входу до SSH"

#: core/remoteview.cpp:714
#, kde-format
msgctxt "@label"
msgid "The SSH server did not accept the login."
msgstr "Сервер SSH не прийняв спроби входу."

#: core/remoteview.cpp:715
#, kde-format
