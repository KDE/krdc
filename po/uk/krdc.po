#: rdp/rdpview.cpp:232
#, kde-format
msgctxt "@label"
msgid "Access to this system requires a username and password."
msgstr "Для доступу до цієї системи потрібен ім'я користувача і пароль."

#: rdp/rdpview.cpp:273
#, kde-format
msgctxt "@label"
msgid "The certificate for this system is unknown. Do you wish to continue?"
msgstr "Сертифікат для цієї системи є невідомим. Хочете продовжувати?"

#: rdp/rdpview.cpp:274
#, kde-format
msgctxt "@title:dialog"
msgid "Verify Certificate"
msgstr "Перевірка сертифіката"

#: rdp/rdpview.cpp:279 rdp/rdpview.cpp:305
#, kde-format
msgctxt "@label"
msgid "Remember this certificate"
msgstr "Запам'ятати цей сертифікат"

#: rdp/rdpview.cpp:299
#, kde-format
msgctxt "@label"
msgid "The certificate for this system has changed. Do you wish to continue?"
msgstr "Сертифікат для цієї системи було змінено. Хочете продовжувати?"

#: rdp/rdpview.cpp:300
#, kde-format
msgctxt "@title:dialog"
msgid "Certificate has Changed"
msgstr "Сертифікат змінено"

#: rdp/rdpview.cpp:303
#, kde-format
msgctxt "@label"
msgid ""
"Previous certificate:\n"
"%1\n"
"New Certificate:\n"
"%2"
msgstr ""
"Попередній сертифікат:\n"
"%1\n"
"Новий сертифікат:\n"
"%2"

#: rdp/rdpview.cpp:348
#, kde-format
msgctxt "@label"
msgid "The credentials for “%1” were not accepted."
msgstr "Реєстраційні дані для «%1» не було прийнято."

#: rdp/rdpview.cpp:351
#, kde-format
msgctxt "@info"
msgid "Check the RD Gateway credentials in the host settings."
msgstr ""
"Перевірте реєстраційні дані для шлюзу віддаленої стільниці у параметрах "
"вузла."

#: rdp/rdpview.cpp:367
#, kde-format
msgctxt "@label"
msgid "This account may not log in remotely."
msgstr "Цьому обліковому запису заборонено віддалений вхід до системи."

#: rdp/rdpview.cpp:368
#, kde-format
msgctxt "@label"
msgid "“%1” may not log in remotely."
msgstr "«%1» заборонено віддалений вхід."

#: rdp/rdpview.cpp:370
#, kde-format
msgctxt "@title connection error"
msgid "Access denied"
msgstr "Доступ заборонено"

#: rdp/rdpview.cpp:372
#, kde-format
msgctxt "@info"
msgid "Check whether the account is locked, disabled or expired."
msgstr ""
"Перевірте, чи не є обліковий запис заблокованим, вимкненим або чи не "
"завершився його строк дії."

#: rdp/rdpview.cpp:374
#, kde-format
msgctxt "@info"
msgid ""
"Ask the administrator of the remote computer to add the account to the "
"Remote Desktop Users group, or log in with a different account."
msgstr ""
"Попросіть адміністратора віддаленого комп'ютера додати обліковий запис до "
"групи користувачів віддаленої стільниці або увійдіть з іншого облікового "
"запису."

#: rdp/rdpview.cpp:382
#, kde-format
msgctxt "@label"
msgid "The password must be changed before it can be used to log in remotely."
msgstr ""
"Пароль має бути змінено до того, як ним можна буде скористатися для "
"віддаленого входу."

#: rdp/rdpview.cpp:383
#, kde-format
msgctxt "@title connection error"
msgid "Password expired"
msgstr "Строк дії пароля вичерпано"

#: rdp/rdpview.cpp:385
#, kde-format
msgctxt "@info"
msgid ""
"Change the password by logging in locally on the remote computer, or ask its "
"administrator to reset it."
msgstr ""
"Змініть пароль, увійшовши до системи локально на віддаленому комп'ютері, або "
"попросіть адміністратора скинути його."

#: rdp/rdpview.cpp:390
#, kde-format
msgctxt "@label"
msgid "The Kerberos domain controller could not be reached."
msgstr "Не вдалося встановити зв'язок із контролером домену Kerberos."

#: rdp/rdpview.cpp:392
#, kde-format
msgctxt "@info"
msgid "Check the domain you entered when logging in."
msgstr "Перевірте домен, до якого ви входите при вході до системи."

#: rdp/rdpview.cpp:393
#, kde-format
msgctxt "@info"
msgid "Connect to the network or VPN of the domain."
msgstr "Встановіть з'єднання з мережею або VPN домену."

#: rdp/rdpview.cpp:398 spice/spiceview.cpp:901 vnc/vncview.cpp:287
#, kde-format
msgctxt "@label"
msgid "No IP address was found for this name."
msgstr "Для цієї назви не знайдено IP-адреси."

#: rdp/rdpview.cpp:409
#, kde-format
msgctxt "@label"
msgid "The server and KRDC could not agree on a security protocol."
msgstr "Серверу і KRDC не вдалося узгодити протокол захисту."

#: rdp/rdpview.cpp:411
#, kde-format
msgctxt "@info"
msgid ""
"Set the TLS security level in the host settings to “Any”. The server may not "
"support the level selected."
msgstr ""
"Встановіть для рівня захисту TLS у параметрах вузла значення «Будь-який». "
"Можливо, на сервері не передбачено вибору рівня."

#: rdp/rdpview.cpp:415
#, kde-format
msgctxt "@label"
msgid "The server requires Network Level Authentication (NLA)."
msgstr "Сервер потребує розпізнавання на рівні мережі (NLA)."

#: rdp/rdpview.cpp:416
#, kde-format
msgctxt "@info"
msgid "Enable NLA in the security settings for this host."
msgstr "Увімкніть NLA у параметрах захисту для цього вузла."

#: rdp/rdpview.cpp:434
#, kde-format
msgctxt "@info"
msgid ""
"Check the RD Gateway settings for this host. The gateway “%1” may be "
"unreachable or reject the connection."
msgstr ""
"Перевірте параметри шлюзу віддаленої стільниці для цього вузла. Шлюз «%1» "
"може бути недосяжним або відмовляти у з'єднанні."

#: rdp/rdpview.cpp:441
#, kde-format
msgctxt "@label"
msgid "The remote computer did not finish starting the session in time."
msgstr "Віддалений комп'ютер не завершив вчасно започаткування сеансу."

#: rdp/rdpview.cpp:442
#, kde-format
msgctxt "@info"
msgid ""
"The remote computer may still be starting up or be under heavy load. Wait a "
"minute, then connect again."
msgstr ""
"Можливо, віддалений комп'ютер не завершив запуск або перевантажений. "
"Зачекайте, а потім спробуйте встановити з'єднання знову."

#: rdp/rdpview.cpp:446
#, kde-format
msgctxt "@label"
msgid "It accepted the connection, then refused to start a session."
msgstr "З'єднання прийнято, а потім відмовлено у започаткуванні сеансу."

#: rdp/rdpview.cpp:447
#, kde-format
msgctxt "@title connection error"
msgid "Session refused"
msgstr "У сеансі відмовлено"

#: rdp/rdpview.cpp:451
#, kde-format
msgctxt "@label"
msgid "The server did not accept the options selected for this host."
msgstr "Сервер відмовився приймати параметри, вибрані для цього вузла."

#: rdp/rdpview.cpp:454
#, kde-format
msgctxt "@label"
msgid "An administrator or another program disconnected this session."
msgstr "З'єднання з цим сеансом перервано адміністратором або іншою програмою."

#: rdp/rdpview.cpp:457
#, kde-format
msgctxt "@label"
msgid "An administrator signed this session out."
msgstr "Користувача викинуто з цього сеансу адміністратором."

#: rdp/rdpview.cpp:460
#, kde-format
msgctxt "@label"
msgid "The session was disconnected from the remote computer."
msgstr "З'єднання з сеансом розірвано з віддаленого комп'ютера."

#: rdp/rdpview.cpp:467
#, kde-format
msgctxt "@label"
msgid "Disconnected because someone else connected to this session."
msgstr ""
"З'єднання розірвано, оскільки з цим сеансом встановив з'єднання хтось інший."

#: rdp/rdpview.cpp:468
#, kde-format
msgctxt "@info"
msgid "Reconnect to take the session back. This disconnects the other user."
msgstr ""
"Повторіть встановлення з'єднання, щоб повернути сеанс. У результаті іншого "
"користувача буде від'єднано."

#: rdp/rdpview.cpp:471
#, kde-format
msgctxt "@label"
msgid "The session was closed after being idle for too long."
msgstr "Сеанс було закрито після надто великого періоду бездіяльності."

#: rdp/rdpview.cpp:472
#, kde-format
msgctxt "@info"
msgid ""
"Reconnect to continue. The idle time limit is set by the administrator of "
"the server."
msgstr ""
"Повторіть спробу з'єднання для продовження роботи. Час бездіяльності "
"встановлює адміністратор сервера."

#: rdp/rdpview.cpp:486
#, kde-format
msgctxt "@label"
msgid "The remote computer reported a problem while logging in."
msgstr ""
"Віддаленим комп'ютером повідомлено про проблему під час спроби увійти до "
"системи."

#: rdp/rdpview.cpp:487
#, kde-format
msgctxt "@info"
msgid ""
"Check that this user may log in to the remote computer, and that the session "
"is not busy."
msgstr ""
"Перевірте, чи може цей користувач входити на віддалений комп'ютер, і що "
"сеанс не є зайнятим."

