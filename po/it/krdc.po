#: core/connectionerror.cpp:15
#, kde-format
msgctxt "@info connection stage"
msgid "Setting up the SSH tunnel"
msgstr "Configurazione del tunnel SSH"

#: core/connectionerror.cpp:17
#, kde-format
msgctxt "@info connection stage"
msgid "Looking up the host name"
msgstr "Ricerca del nome host"

#: core/connectionerror.cpp:19
#, kde-format
msgctxt "@info connection stage"
msgid "Connecting to the server"
msgstr "Connessione al server"

#: core/connectionerror.cpp:21
#, kde-format
msgctxt "@info connection stage"
msgid "Securing the connection"
msgstr "Protezione della connessione"

#: core/connectionerror.cpp:23
#, kde-format
msgctxt "@info connection stage"
msgid "Logging in"
msgstr "Accesso"

#: core/connectionerror.cpp:25
#, kde-format
msgctxt "@info connection stage"
msgid "Starting the remote session"
msgstr "Avvio della sessione remota"

#: core/connectionerror.cpp:27
#, kde-format
msgctxt "@info connection stage"
msgid "Connection interrupted"
msgstr "Connessione interrotta"

#: core/connectionerror.cpp:29
#, kde-format
msgctxt "@info connection stage"
msgid "Session ended remotely"
msgstr "Sessione terminata da remoto"

#: core/connectionerror.cpp:33
#, kde-format
msgctxt "@info connection stage"
msgid "Unknown"
msgstr "Sconosciuto"

#: core/connectionerror.cpp:45
#, kde-format
msgctxt "@title connection error"
msgid "SSH tunnel failed"
msgstr "Tunnel SSH non riuscito"

#: core/connectionerror.cpp:47
#, kde-format
msgctxt "@info"
msgid "Check the SSH tunnel user name and port in the host settings."
msgstr ""
"Verifica il nome utente e la porta del tunnel SSH nelle impostazioni "
"dell'host."

#: core/connectionerror.cpp:48
#, kde-format
msgctxt "@info"
msgid ""
"Log in with an SSH client in a terminal to confirm that the server is "
"reachable and your credentials work."
msgstr ""
"Accedi tramite un client SSH in un terminale per verificare che il server "
"sia raggiungibile e che le tue credenziali funzionino."

#: core/connectionerror.cpp:49
#, kde-format
msgctxt "@info"
msgid ""
"If you use key authentication, add the key to your SSH agent with ssh-add."
msgstr ""
"Se utilizzi l'autenticazione tramite chiave, aggiungi la chiave al tuo "
"agente SSH usando ssh-add."

#: core/connectionerror.cpp:50
#, kde-format
msgctxt "@info"
msgid "Make sure the SSH server allows port forwarding."
msgstr "Assicurati che il server SSH consenta il port forwarding."

#: core/connectionerror.cpp:54
#, kde-format
msgctxt "@title connection error"
msgid "Server not found"
msgstr "Server non trovato"

#: core/connectionerror.cpp:56
#, kde-format
msgctxt "@info"
msgid "Check the spelling of the address."
msgstr "Controlla l'ortografia dell'indirizzo."

#: core/connectionerror.cpp:57
#, kde-format
msgctxt "@info"
msgid "Connect to the network or VPN the computer is on."
msgstr "Collegati alla rete o alla VPN su cui si trova il computer."

#: core/connectionerror.cpp:58
#, kde-format
msgctxt "@info"
msgid "Try the IP address of the computer instead of its name."
msgstr "Prova a utilizzare l'indirizzo IP del computer invece del suo nome."

#: core/connectionerror.cpp:63
#, kde-format
msgctxt "@title connection error"
msgid "Server not reachable"
msgstr "Server non raggiungibile"

#: core/connectionerror.cpp:65 core/connectionerror.cpp:145
#, kde-format
msgctxt "@info"
msgid ""
"Make sure the remote computer is turned on, awake and connected to the "
"network."
msgstr ""
"Assicurati che il computer remoto sia acceso, attivo e connesso alla rete."

#: core/connectionerror.cpp:66 core/connectionerror.cpp:135
#, kde-format
msgctxt "@info"
msgid "Check that remote desktop sharing is enabled on the remote computer."
msgstr ""
"Verifica che la condivisione del desktop remoto sia abilitata sul computer "
"remoto."

#: core/connectionerror.cpp:67 core/connectionerror.cpp:136
#, kde-format
msgctxt "@info"
msgid ""
"Check the port in the address. The defaults are 3389 for RDP and 5900 for "
"VNC and SPICE."
msgstr ""
"Verifica la porta nell'indirizzo. I valori predefiniti sono 3389 per RDP e "
"5900 per VNC e SPICE."

#: core/connectionerror.cpp:68 core/connectionerror.cpp:146
#, kde-format
msgctxt "@info"
msgid "Check that no firewall blocks the connection."
msgstr "Verifica che nessun firewall blocchi la connessione."

#: core/connectionerror.cpp:73
#, kde-format
msgctxt "@title connection error"
msgid "Secure connection failed"
msgstr "Connessione sicura non riuscita"

#: core/connectionerror.cpp:75
#, kde-format
msgctxt "@info"
msgid ""
"Review the security settings for this host, or reset them to their defaults."
msgstr ""
"Esamina le impostazioni di sicurezza per questo host oppure ripristinale ai "
"valori predefiniti."

#: core/connectionerror.cpp:76
#, kde-format
msgctxt "@info"
msgid ""
"If the server certificate changed unexpectedly, confirm the change with the "
"server administrator before accepting it."
msgstr ""
"Se il certificato del server è cambiato inaspettatamente, verifica tale "
"modifica con l'amministratore del server prima di accettarlo."

#: core/connectionerror.cpp:80
#, kde-format
msgctxt "@title connection error"
msgid "Authentication failed"
msgstr "Autenticazione non riuscita"

#: core/connectionerror.cpp:82
#, kde-format
msgctxt "@info"
msgid "Check the user name, password and domain, and that Caps Lock is off."
msgstr ""
"Verifica il nome utente, la password e il dominio, e accertati che il tasto "
"Bloc Maiusc sia disattivato."

#: core/connectionerror.cpp:83
#, kde-format
msgctxt "@info"
msgid "If you use a saved password, enter it again. It may be out of date."
msgstr ""
"Se utilizzi una password salvata, digitala di nuovo. Potrebbe non essere "
"aggiornata."

#: core/connectionerror.cpp:84
#, kde-format
msgctxt "@info"
msgid ""
"If the account is locked or expired, contact the administrator of the remote "
"computer."
msgstr ""
"Se l'account è bloccato o scaduto, contatta l'amministratore del computer "
"remoto."

#: core/connectionerror.cpp:88
#, kde-format
msgctxt "@title connection error"
msgid "Session setup failed"
msgstr "Configurazione della sessione non riuscita"

#: core/connectionerror.cpp:90
#, kde-format
msgctxt "@info"
msgid ""
"Reset advanced options in the host settings, such as graphics acceleration "
"or color depth, to their defaults."
msgstr ""
"Ripristina le opzioni avanzate nelle impostazioni dell'host, come "
"l'accelerazione grafica o la profondità del colore, ai valori predefiniti."

#: core/connectionerror.cpp:91
#, kde-format
msgctxt "@info"
msgid ""
"Ask the administrator of the remote computer whether new sessions are "
"allowed. The number of users may be limited."
msgstr ""
"Chiedi all'amministratore del computer remoto se sono consentite nuove "
"sessioni. Il numero di utenti potrebbe essere limitato."

#: core/connectionerror.cpp:96
#, kde-format
msgctxt "@title connection error"
msgid "Network connection interrupted"
msgstr "Connessione di rete interrotta"

#: core/connectionerror.cpp:98
#, kde-format
msgctxt "@info"
msgid "Check your network connection, then reconnect."
msgstr "Controlla la tua connessione di rete, quindi riconnettiti."

#: core/connectionerror.cpp:99
#, kde-format
msgctxt "@info"
msgid ""
"If the remote computer restarted or went to sleep, wait until it is back, "
"then reconnect."
msgstr ""
"Se il computer remoto si è riavviato o è entrato in modalità sospensione, "
"attendi che torni operativo, quindi riconnettiti."

#: core/connectionerror.cpp:104
#, kde-format
msgctxt "@title connection error"
msgid "Closed by the server"
msgstr "Chiusa dal server"

#: core/connectionerror.cpp:109
#, kde-format
msgctxt "@title connection error"
msgid "Unexpected error"
msgstr "Errore inatteso"

#: core/connectionerror.cpp:118
#, kde-format
msgctxt "@label"
msgid "It accepted the connection, then closed it before the session started."
msgstr ""
"Ha accettato la connessione, poi l'ha chiusa prima che la sessione avesse "
"inizio."

#: core/connectionerror.cpp:119
#, kde-format
msgctxt "@title connection error"
msgid "Server closed the connection"
msgstr "Il server ha chiuso la connessione"

#: core/connectionerror.cpp:121
#, kde-format
msgctxt "@info"
msgid ""
"If another viewer is connected, close it. Some servers allow only one at a "
"time."
msgstr ""
"Se è connesso un altro visualizzatore, chiudilo. Alcuni server ne consentono "
"uno solo alla volta."

#: core/connectionerror.cpp:122
#, kde-format
msgctxt "@info"
msgid "Check that this port belongs to the remote desktop service you expect."
msgstr ""
"Verifica che questa porta appartenga al servizio di desktop remoto che ti "
"aspetti."

#: core/connectionerror.cpp:123
#, kde-format
msgctxt "@info"
msgid ""
