"Host: %1:%2\n"
"Nome comune: %3\n"
"Oggetto: %4\n"
"Emittente: %5\n"
"Impronta digitale: %6\n"

#: rdp/rdpview.cpp:232
#, kde-format
msgctxt "@label"
msgid "Access to this system requires a username and password."
msgstr "L'accesso a questo sistema richiede un nome utente e una password."

#: rdp/rdpview.cpp:272
#, kde-format
msgctxt "@label"
msgid "The certificate for this system is unknown. Do you wish to continue?"
msgstr "Il certificato per questo sistema è sconosciuto. Vuoi continuare?"

#: rdp/rdpview.cpp:273
#, kde-format
msgctxt "@title:dialog"
msgid "Verify Certificate"
msgstr "Verifica certificato"

#: rdp/rdpview.cpp:278 rdp/rdpview.cpp:304
#, kde-format
msgctxt "@label"
msgid "Remember this certificate"
msgstr "Ricorda questo certificato"

#: rdp/rdpview.cpp:298
#, kde-format
msgctxt "@label"
msgid "The certificate for this system has changed. Do you wish to continue?"
msgstr "Il certificato per questo sistema è cambiato. Vuoi continuare?"

#: rdp/rdpview.cpp:299
#, kde-format
msgctxt "@title:dialog"
msgid "Certificate has Changed"
msgstr "Il certificato è cambiato"

#: rdp/rdpview.cpp:302
#, kde-format
msgctxt "@label"
msgid ""
"Previous certificate:\n"
"%1\n"
"New Certificate:\n"
"%2"
msgstr ""
"Certificato precedente:\n"
"%1\n"
"Nuovo certificato:\n"
"%2"

#: rdp/rdpview.cpp:347
#, kde-format
msgctxt "@label"
msgid "The credentials for “%1” were not accepted."
msgstr "Le credenziali per «%1» non sono state accettate."

#: rdp/rdpview.cpp:350
#, kde-format
msgctxt "@info"
msgid "Check the RD Gateway credentials in the host settings."
msgstr "Verifica le credenziali del Gateway RD nelle impostazioni dell'host."

#: rdp/rdpview.cpp:366
#, kde-format
msgctxt "@label"
msgid "This account may not log in remotely."
msgstr "Questo account non può effettuare l'accesso da remoto."

#: rdp/rdpview.cpp:367
#, kde-format
msgctxt "@label"
msgid "“%1” may not log in remotely."
msgstr "«%1» non può effettuare l'accesso da remoto."

#: rdp/rdpview.cpp:369
#, kde-format
msgctxt "@title connection error"
msgid "Access denied"
msgstr "Accesso negato"

#: rdp/rdpview.cpp:371
#, kde-format
msgctxt "@info"
msgid "Check whether the account is locked, disabled or expired."
msgstr "Verifica se l'account è bloccato, disabilitato o scaduto."

#: rdp/rdpview.cpp:373
#, kde-format
msgctxt "@info"
msgid ""
"Ask the administrator of the remote computer to add the account to the "
"Remote Desktop Users group, or log in with a different account."
msgstr ""
"Chiedi all'amministratore del computer remoto di aggiungere l'account al "
"gruppo Utenti desktop remoto, oppure accedi con un account diverso."

#: rdp/rdpview.cpp:381
#, kde-format
msgctxt "@label"
msgid "The password must be changed before it can be used to log in remotely."
msgstr ""
"La password deve essere modificata prima di poter essere utilizzata per "
"effettuare l'accesso da remoto."

#: rdp/rdpview.cpp:382
#, kde-format
msgctxt "@title connection error"
msgid "Password expired"
msgstr "Password scaduta"

#: rdp/rdpview.cpp:384
#, kde-format
msgctxt "@info"
msgid ""
"Change the password by logging in locally on the remote computer, or ask its "
"administrator to reset it."
msgstr ""
"Modifica la password effettuando l'accesso localmente al computer remoto, "
"oppure chiedi al suo amministratore di reimpostarla."

#: rdp/rdpview.cpp:389
#, kde-format
msgctxt "@label"
msgid "The Kerberos domain controller could not be reached."
msgstr "Non è stato possibile raggiungere il controller di dominio Kerberos."

#: rdp/rdpview.cpp:391
#, kde-format
msgctxt "@info"
msgid "Check the domain you entered when logging in."
msgstr "Controlla il dominio che hai inserito al momento dell'accesso."

#: rdp/rdpview.cpp:392
#, kde-format
msgctxt "@info"
msgid "Connect to the network or VPN of the domain."
msgstr "Connettiti alla rete o alla VPN del dominio."

#: rdp/rdpview.cpp:397 spice/spiceview.cpp:901 vnc/vncview.cpp:287
#, kde-format
msgctxt "@label"
msgid "No IP address was found for this name."
msgstr "Non è stato trovato alcun indirizzo IP per questo nome."

#: rdp/rdpview.cpp:408
#, kde-format
msgctxt "@label"
msgid "The server and KRDC could not agree on a security protocol."
msgstr ""
"Il server e KRDC non sono riusciti a concordare un protocollo di sicurezza."

#: rdp/rdpview.cpp:410
#, kde-format
msgctxt "@info"
msgid ""
"Set the TLS security level in the host settings to “Any”. The server may not "
"support the level selected."
msgstr ""
"Imposta il livello di sicurezza TLS nelle impostazioni dell'host su «Any». È "
"possibile che il server non supporti il ​​livello selezionato."

#: rdp/rdpview.cpp:414
#, kde-format
msgctxt "@label"
msgid "The server requires Network Level Authentication (NLA)."
msgstr "Il server richiede l'autenticazione a livello di rete (NLA)."

#: rdp/rdpview.cpp:415
#, kde-format
msgctxt "@info"
msgid "Enable NLA in the security settings for this host."
msgstr "Abilita NLA nelle impostazioni di sicurezza per questo host."

#: rdp/rdpview.cpp:433
#, kde-format
msgctxt "@info"
msgid ""
"Check the RD Gateway settings for this host. The gateway “%1” may be "
"unreachable or reject the connection."
msgstr ""
"Controlla le impostazioni del Gateway RD per questo host. Il gateway «%1» "
"potrebbe non essere raggiungibile oppure potrebbe rifiutare la connessione."

#: rdp/rdpview.cpp:440
#, kde-format
msgctxt "@label"
msgid "The remote computer did not finish starting the session in time."
msgstr "Il computer remoto non ha completato l'avvio della sessione in tempo."

#: rdp/rdpview.cpp:441
#, kde-format
msgctxt "@info"
msgid ""
"The remote computer may still be starting up or be under heavy load. Wait a "
"minute, then connect again."
msgstr ""
"Il computer remoto potrebbe essere ancora in fase di avvio o sotto un carico "
"di lavoro elevato. Attendi un minuto, quindi riprova a connetterti."

#: rdp/rdpview.cpp:445
#, kde-format
msgctxt "@label"
msgid "It accepted the connection, then refused to start a session."
msgstr ""
"Ha accettato la connessione, poi si è rifiutata di avviare una sessione."

#: rdp/rdpview.cpp:446
#, kde-format
msgctxt "@title connection error"
msgid "Session refused"
msgstr "Sessione rifiutata"

#: rdp/rdpview.cpp:450
#, kde-format
msgctxt "@label"
msgid "The server did not accept the options selected for this host."
msgstr "Il server non ha accettato le opzioni selezionate per questo host."

#: rdp/rdpview.cpp:453
#, kde-format
msgctxt "@label"
