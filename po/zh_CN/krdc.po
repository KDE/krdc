msgstr "无法连接到 Kerberos 域控制器。"

#: rdp/rdpview.cpp:511
#, kde-format
msgctxt "@info"
msgid "Check the domain you entered when logging in."
msgstr "请在登录时检查您输入的域名。"

#: rdp/rdpview.cpp:512
#, kde-format
msgctxt "@info"
msgid "Connect to the network or VPN of the domain."
msgstr "连接到该域的网络或 VPN。"

#: rdp/rdpview.cpp:517 spice/spiceview.cpp:964 vnc/vncview.cpp:300
#, kde-format
msgctxt "@label"
