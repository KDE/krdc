#, kde-format
msgctxt "@info"
msgid ""
"Ask the administrator of the gateway to check its connection authorization "
"policy."
msgstr "请要求网关管理员检查其连接授权策略。"

#: rdp/rdpview.cpp:587
#, kde-format
msgctxt "@label"
msgid "The gateway could not reach “%1”."
msgstr "网关无法连接到“%1”。"

#: rdp/rdpview.cpp:589
#, kde-format
msgctxt "@info"
msgid ""
"Make sure the remote computer is running, and that the gateway can reach it "
"by this name."
msgstr "请确保远程计算机正在运行，并且网关能够通过此名称访问它。"

