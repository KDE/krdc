msgstr "Otvorite novi .vv fajl za ovu virtuelnu mašinu."

#: spice/spiceview.cpp:883
#, kde-format
msgctxt "@info"
msgid ""
"The server rejected the password in the connection file, which may have "
"expired. Open a new file, or enter the password."
msgstr ""
"Server je odbio lozinku iz fajla veze, koja je možda istekla. Otvorite novi "
"fajl ili unesite lozinku."

#: spice/spiceview.cpp:885
#, kde-format
msgid "Authentication is required to connect to <b>%1</b>."
msgstr "Za povezivanje sa <b>%1</b> potrebna je autentifikacija."

#: spice/spiceview.cpp:955
#, kde-format
msgctxt "@label"
msgid "The TLS handshake failed."
msgstr "TLS rukovanje nije uspjelo."

#: spice/spiceview.cpp:956
#, kde-format
msgctxt "@info"
msgid ""
"Check whether the server accepts TLS only on a separate port, and that its "
"certificate is trusted."
msgstr ""
"Provjerite da li server prihvata TLS samo na zasebnom portu i da li je "
"njegov sertifikat pouzdan."

#: spice/spiceview.cpp:959
#, kde-format
msgctxt "@label"
msgid "The server rejected the SPICE connection."
msgstr "Server je odbio SPICE vezu."

#: spice/spiceview.cpp:960
#, kde-format
msgctxt "@info"
msgid ""
"Check that this port belongs to a SPICE server with a compatible protocol "
"version."
msgstr ""
"Provjerite da li ovaj port pripada SPICE serveru sa saglasnom verzijom "
"protokola."

#: spice/spiceview.cpp:970
#, kde-format
msgctxt "@info"
msgid ""
"Make sure the virtual machine is running, and its SPICE display listens on "
"this address."
msgstr ""
"Provjerite da li je virtuelna mašina pokrenuta i da li njen SPICE ekran "
"osluškuje na ovoj adresi."

#: spice/spiceviewfactory.cpp:174
#, kde-format
msgctxt "@info %1 is a server address"
msgid ""
"This file connects through the proxy “%1”, which could intercept the "
"session. Continue only if you trust this file."
msgstr ""
"Ovaj fajl se povezuje kroz proksi „%1“, koji bi mogao da presretne sesiju. "
"Nastavite samo ako vjerujete ovom fajlu."

#: spice/spiceviewfactory.cpp:176
#, kde-format
msgctxt "@title:window"
msgid "Use Proxy from File?"
msgstr "Upotrijebiti proksi iz fajla?"

