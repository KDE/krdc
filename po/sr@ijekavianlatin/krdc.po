#: core/remoteview.cpp:879
#, kde-format
msgctxt "@info"
msgid ""
"Check the host name, and that the computer is reachable from this network."
msgstr "Provjerite ime domaćina i da li je računar dostupan iz ove mreže."

#: core/remoteview.cpp:880
#, kde-format
msgctxt "@info"
msgid "Check that no firewall blocks SSH connections."
msgstr "Provjerite da nijedan zaštitni zid ne blokira SSH veze."

