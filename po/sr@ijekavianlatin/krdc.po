"Fingerprint: %6\n"
msgstr ""
"Domaćin: %1:%2\n"
"Uobičajeno ime: %3\n"
"Predmet: %4\n"
"Izdavač: %5\n"
"Otisak: %6\n"

#: rdp/rdpview.cpp:296
#, kde-format
msgctxt "@label"
msgid "Access to the gateway and this system requires a username and password."
msgstr ""
"Pristup mrežnom izlazu i ovom sistemu zahtijeva korisničko ime i lozinku."

#: rdp/rdpview.cpp:297
#, kde-format
msgctxt "@label"
msgid "Access to this system requires a username and password."
msgstr "Pristup ovom sistemu zahtijeva korisničko ime i lozinku."

#: rdp/rdpview.cpp:352
#, kde-format
msgctxt "@label %1 is a server address"
msgid "Access to the gateway %1 requires a username and password."
msgstr "Pristup mrežnom izlazu %1 zahtijeva korisničko ime i lozinku."

#: rdp/rdpview.cpp:373
#, kde-format
msgctxt "@label"
msgid "The certificate for this gateway is unknown. Do you wish to continue?"
msgstr "Sertifikat za ovaj mrežni izlaz nije poznat. Želite li da nastavite?"

#: rdp/rdpview.cpp:374
#, kde-format
msgctxt "@label"
msgid "The certificate for this system is unknown. Do you wish to continue?"
msgstr "Sertifikat za ovaj sistem nije poznat. Želite li da nastavite?"

#: rdp/rdpview.cpp:375
#, kde-format
msgctxt "@title:dialog"
msgid "Verify Certificate"
msgstr "Provjera sertifikata"

#: rdp/rdpview.cpp:380 rdp/rdpview.cpp:412
#, kde-format
msgctxt "@label"
msgid "Remember this certificate"
msgstr "Zapamti ovaj sertifikat"

#: rdp/rdpview.cpp:405
#, kde-format
msgctxt "@label"
msgid "The certificate for this gateway has changed. Do you wish to continue?"
msgstr "Sertifikat za ovaj mrežni izlaz se promijenio. Želite li da nastavite?"

#: rdp/rdpview.cpp:406
#, kde-format
msgctxt "@label"
msgid "The certificate for this system has changed. Do you wish to continue?"
msgstr "Sertifikat za ovaj sistem se promijenio. Želite li da nastavite?"

#: rdp/rdpview.cpp:407
#, kde-format
msgctxt "@title:dialog"
msgid "Certificate has Changed"
msgstr "Sertifikat je promijenjen"

#: rdp/rdpview.cpp:410
#, kde-format
msgctxt "@label"
msgid ""
"Previous certificate:\n"
"%1\n"
"New Certificate:\n"
"%2"
msgstr ""
"Prethodni sertifikat:\n"
"%1\n"
"Novi sertifikat:\n"
"%2"

#: rdp/rdpview.cpp:460
#, kde-format
msgctxt "@label"
msgid "The credentials for “%1” were not accepted."
msgstr "Akreditivi za „%1“ nisu prihvaćeni."

#: rdp/rdpview.cpp:463
#, kde-format
msgctxt "@info"
msgid "Check the RD Gateway credentials in the host settings."
msgstr ""
"Provjerite akreditive za mrežni izlaz udaljene površi u postavkama domaćina."

#: rdp/rdpview.cpp:479
#, kde-format
msgctxt "@label"
msgid "This account may not log in remotely."
msgstr "Ovaj nalog ne smije da se prijavljuje na daljinu."

#: rdp/rdpview.cpp:480
#, kde-format
msgctxt "@label"
msgid "“%1” may not log in remotely."
msgstr "„%1“ ne smije da se prijavljuje na daljinu."

#: rdp/rdpview.cpp:482 rdp/rdpview.cpp:575 rdp/rdpview.cpp:583
#, kde-format
msgctxt "@title connection error"
msgid "Access denied"
msgstr "Pristup odbijen"

#: rdp/rdpview.cpp:485
#, kde-format
msgctxt "@label"
msgid "The gateway or the remote computer refused this login."
msgstr "Mrežni izlaz ili udaljeni računar odbio je ovu prijavu."

#: rdp/rdpview.cpp:491
#, kde-format
msgctxt "@info"
msgid "Check whether the account is locked, disabled or expired."
msgstr "Provjerite da li je nalog zaključan, isključen ili istekao."

#: rdp/rdpview.cpp:493
#, kde-format
msgctxt "@info"
msgid ""
"Ask the administrator of the remote computer to add the account to the "
"Remote Desktop Users group, or log in with a different account."
msgstr ""
"Zatražite od administratora udaljenog računara da doda nalog u grupu "
"korisnika udaljene površi (Remote Desktop Users), ili se prijavite drugim "
"nalogom."

#: rdp/rdpview.cpp:501
#, kde-format
msgctxt "@label"
msgid "The password must be changed before it can be used to log in remotely."
msgstr ""
"Lozinka mora da se promijeni prije nego što može da se koristi za "
"prijavljivanje na daljinu."

#: rdp/rdpview.cpp:502
#, kde-format
msgctxt "@title connection error"
msgid "Password expired"
msgstr "Lozinka je istekla"

#: rdp/rdpview.cpp:504
#, kde-format
msgctxt "@info"
msgid ""
"Change the password by logging in locally on the remote computer, or ask its "
"administrator to reset it."
msgstr ""
"Promijenite lozinku lokalnim prijavljivanjem na udaljeni računar, ili "
"zatražite od njegovog administratora da je resetuje."

#: rdp/rdpview.cpp:509
#, kde-format
msgctxt "@label"
msgid "The Kerberos domain controller could not be reached."
msgstr "Ne mogu da dođem do kontrolera domena Kerberosa."

#: rdp/rdpview.cpp:511
#, kde-format
msgctxt "@info"
msgid "Check the domain you entered when logging in."
msgstr "Provjerite domen koji ste unijeli pri prijavljivanju."

#: rdp/rdpview.cpp:512
#, kde-format
msgctxt "@info"
msgid "Connect to the network or VPN of the domain."
msgstr "Povežite se na mrežu ili VPN domena."

#: rdp/rdpview.cpp:517 spice/spiceview.cpp:964 vnc/vncview.cpp:300
#, kde-format
msgctxt "@label"
msgid "No IP address was found for this name."
msgstr "Nije nađena IP adresa za ovo ime."

#: rdp/rdpview.cpp:528
#, kde-format
msgctxt "@label"
msgid "The server and KRDC could not agree on a security protocol."
msgstr "Server i KRDC nisu mogli da se dogovore o bezbjednosnom protokolu."

#: rdp/rdpview.cpp:531
#, kde-format
msgctxt "@label"
msgid ""
"Logging in to the gateway failed, or the server and KRDC could not agree on "
"a security protocol."
msgstr ""
"Prijavljivanje na mrežni izlaz nije uspjelo, ili server i KRDC nisu mogli da "
"se dogovore o bezbjednosnom protokolu."

#: rdp/rdpview.cpp:535
#, kde-format
msgctxt "@info"
msgid ""
"NTLM is turned off for this host. Turn it on in the host settings unless the "
"domain controller can be reached."
msgstr ""
"NTLM je isključen za ovaj domaćin. Uključite ga u postavkama domaćina, osim "
"ako je kontroler domena dostupan."

#: rdp/rdpview.cpp:538
#, kde-format
msgctxt "@info"
msgid ""
"Set the TLS security level in the host settings to “Any”. The server may not "
"support the level selected."
msgstr ""
"U postavkama domaćina postavite nivo bezbjednosti TLS‑a na „bilo koji“. "
"Server možda ne podržava izabrani nivo."

#: rdp/rdpview.cpp:542
#, kde-format
msgctxt "@label"
msgid "The server requires Network Level Authentication (NLA)."
msgstr "Server zahtijeva autentifikaciju na nivou mreže (NLA)."

#: rdp/rdpview.cpp:543
#, kde-format
msgctxt "@info"
msgid "Enable NLA in the security settings for this host."
msgstr "Uključite NLA u bezbjednosnim postavkama ovog domaćina."

#: rdp/rdpview.cpp:561
#, kde-format
msgctxt "@info"
msgid ""
"Check the RD Gateway settings for this host. The gateway “%1” may be "
"unreachable or reject the connection."
msgstr ""
"Provjerite postavke mrežnog izlaza udaljene površi za ovaj domaćin. Mrežni "
"izlaz „%1“ možda nije dostupan ili odbija vezu."

#: rdp/rdpview.cpp:568
#, kde-format
msgctxt "@label"
msgid "The remote computer did not finish starting the session in time."
msgstr "Udaljeni računar nije na vrijeme završio pokretanje sesije."

#: rdp/rdpview.cpp:569
#, kde-format
msgctxt "@info"
msgid ""
"The remote computer may still be starting up or be under heavy load. Wait a "
"minute, then connect again."
msgstr ""
"Udaljeni računar se možda još pokreće ili je jako opterećen. Sačekajte "
"minut, pa se ponovo povežite."

#: rdp/rdpview.cpp:574
#, kde-format
msgctxt "@label"
msgid "The gateway does not allow this account to connect to “%1”."
msgstr "Mrežni izlaz ne dozvoljava ovom nalogu da se poveže sa „%1“."

#: rdp/rdpview.cpp:577
#, kde-format
msgctxt "@info"
msgid ""
"Try the full name of the computer. The gateway may only know it by that name."
msgstr ""
"Pokušajte sa punim imenom računara. Mrežni izlaz ga možda zna samo pod tim "
"imenom."

#: rdp/rdpview.cpp:578
#, kde-format
msgctxt "@info"
msgid ""
"Ask the administrator of the gateway to allow this account and computer in "
"its resource authorization policy."
msgstr ""
"Zatražite od administratora mrežnog izlaza da dozvoli ovaj nalog i računar u "
"svojoj smjernici za ovlašćenje resursa."

#: rdp/rdpview.cpp:582
#, kde-format
msgctxt "@label"
msgid "The gateway does not allow this device to connect."
msgstr "Mrežni izlaz ne dozvoljava ovom uređaju da se poveže."

#: rdp/rdpview.cpp:584
#, kde-format
msgctxt "@info"
msgid ""
"Ask the administrator of the gateway to check its connection authorization "
"policy."
msgstr ""
"Zatražite od administratora mrežnog izlaza da provjeri svoju smjernicu za "
"ovlašćenje veza."

#: rdp/rdpview.cpp:587
#, kde-format
msgctxt "@label"
msgid "The gateway could not reach “%1”."
msgstr "Mrežni izlaz nije mogao da dođe do „%1“."

#: rdp/rdpview.cpp:589
#, kde-format
msgctxt "@info"
msgid ""
"Make sure the remote computer is running, and that the gateway can reach it "
"by this name."
msgstr ""
"Provjerite da li je udaljeni računar pokrenut i da li mrežni izlaz može da "
"dođe do njega pod ovim imenom."

#: rdp/rdpview.cpp:593
#, kde-format
msgctxt "@label"
msgid "It accepted the connection, then refused to start a session."
msgstr "Server je prihvatio vezu, a zatim odbio da pokrene sesiju."

#: rdp/rdpview.cpp:594
#, kde-format
msgctxt "@title connection error"
msgid "Session refused"
msgstr "Sesija je odbijena"

#: rdp/rdpview.cpp:598
#, kde-format
msgctxt "@label"
msgid "The server did not accept the options selected for this host."
msgstr "Server nije prihvatio opcije izabrane za ovaj domaćin."

#: rdp/rdpview.cpp:601
#, kde-format
msgctxt "@label"
msgid "An administrator or another program disconnected this session."
msgstr "Administrator ili drugi program prekinuo je ovu sesiju."

#: rdp/rdpview.cpp:604
#, kde-format
msgctxt "@label"
msgid "An administrator signed this session out."
msgstr "Administrator je odjavio ovu sesiju."

#: rdp/rdpview.cpp:607
#, kde-format
msgctxt "@label"
msgid "The session was disconnected from the remote computer."
msgstr "Sesija je prekinuta sa udaljenog računara."

#: rdp/rdpview.cpp:614
#, kde-format
msgctxt "@label"
msgid "Disconnected because someone else connected to this session."
msgstr "Veza je prekinuta jer se neko drugi povezao na ovu sesiju."

#: rdp/rdpview.cpp:615
#, kde-format
msgctxt "@info"
msgid "Reconnect to take the session back. This disconnects the other user."
msgstr ""
"Ponovo se povežite da biste vratili sesiju. Time ćete prekinuti vezu drugog "
"korisnika."

#: rdp/rdpview.cpp:618
#, kde-format
msgctxt "@label"
msgid "The session was closed after being idle for too long."
msgstr "Sesija je zatvorena poslije predugog mirovanja."

#: rdp/rdpview.cpp:619
#, kde-format
msgctxt "@info"
msgid ""
"Reconnect to continue. The idle time limit is set by the administrator of "
"the server."
msgstr ""
"Ponovo se povežite da biste nastavili. Ograničenje vremena mirovanja "
"postavlja administrator servera."

#: rdp/rdpview.cpp:633
#, kde-format
msgctxt "@label"
msgid "The remote computer reported a problem while logging in."
msgstr "Udaljeni računar je javio problem pri prijavljivanju."

#: rdp/rdpview.cpp:634
#, kde-format
msgctxt "@info"
msgid ""
"Check that this user may log in to the remote computer, and that the session "
"is not busy."
msgstr ""
"Provjerite da li ovaj korisnik smije da se prijavi na udaljeni računar i da "
"sesija nije zauzeta."

#: rdp/rdpview.cpp:1020
#, kde-format
msgctxt "@title:window"
msgid "KRDC – Screen %1"
msgstr "KRDC – ekran %1"

#: rdp/rdpviewfactory.cpp:112
#, kde-format
msgid "Connect to a Windows Remote Desktop (RDP)"
msgstr "Poveži se na udaljenu windows površ (RDP)"

#: rdp/rdpviewfactory.cpp:193
#, kde-format
msgctxt "@info %1 is a server address"
msgid "This file requires a gateway, but its address “%1” is not valid."
msgstr ""
"Ovaj fajl zahtijeva mrežni izlaz, ali njegova adresa „%1“ nije ispravna."

#: rdp/rdpviewfactory.cpp:194
#, kde-format
msgctxt "@title:window"
msgid "Invalid Gateway"
msgstr "Loš mrežni izlaz"

#: rdp/rdpviewfactory.cpp:203
#, kde-format
msgctxt "@info %1 is a server address"
msgid ""
"This file connects through the gateway “%1”, which could capture your login "
"details. Continue only if you trust this file."
msgstr ""
"Ovaj fajl se povezuje kroz mrežni izlaz „%1“, koji bi mogao da uhvati vaše "
"prijavne podatke. Nastavite samo ako vjerujete ovom fajlu."

#: rdp/rdpviewfactory.cpp:206
#, kde-format
msgctxt "@title:window"
msgid "Use Gateway from File?"
msgstr "Upotrijebiti mrežni izlaz iz fajla?"

#: rdp/rdpviewfactory.cpp:280
#, kde-format
msgid "New RDP Connection…"
msgstr "Nova RDP veza…"

#: rdp/rdpviewfactory.cpp:291
#, kde-format
msgid ""
"<html>Enter the address here. Port is optional.<br /><i>Example: "
"rdpserver:3389 (host:port)</i></html>"
msgstr ""
"<html>Unesite adresu ovdje. Port nije obavezan.<br /><i>Na primjer: "
"<tt>rdpserver:3389</tt> (domaćin:port)</i></html>"

