     <widget class="QWidget" name="securityTab">
      <attribute name="title">
       <string>Security</string>
      </attribute>
      <layout class="QFormLayout" name="securityLayout">
       <item row="0" column="0">
        <widget class="QLabel" name="protocolsLabel">
         <property name="text">
          <string>Protocols:</string>
         </property>
        </widget>
       </item>
       <item row="0" column="1">
        <layout class="QHBoxLayout" name="protocolsLayout">
         <item>
          <widget class="QCheckBox" name="kcfg_SecurityNLA">
           <property name="text">
            <string>NLA</string>
           </property>
           <property name="toolTip">
            <string>Network Level Authentication: sign in before the remote session starts.</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="kcfg_SecurityTLS">
           <property name="text">
            <string>TLS</string>
           </property>
           <property name="toolTip">
            <string>TLS encryption, signing in on the login screen of the remote computer.</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="kcfg_SecurityRDP">
           <property name="text">
            <string>RDP</string>
           </property>
           <property name="toolTip">
            <string>Standard RDP security, the older encryption built into the protocol.</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="kcfg_SecurityEXT">
           <property name="text">
            <string>Ext</string>
           </property>
           <property name="toolTip">
            <string>Extended Network Level Authentication, which also checks that the account may sign in before the session starts.</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="protocolsSpacer">
           <property name="orientation">
            <enum>Qt::Orientation::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="TlsSecLevelLabel">
         <property name="text">
          <string>TLS security level:</string>
         </property>
         <property name="buddy">
          <cstring>kcfg_TlsSecLevel</cstring>
         </property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="KComboBox" name="kcfg_TlsSecLevel">
         <property name="toolTip">
          <string>The weakest TLS encryption to accept. A higher level may refuse to connect to older servers.</string>
         </property>
         <property name="sizePolicy">
          <sizepolicy hsizetype="MinimumExpanding" vsizetype="Fixed">
           <horstretch>0</horstretch>
           <verstretch>0</verstretch>
          </sizepolicy>
         </property>
         <item>
          <property name="text">
           <string>Any</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>80 bit</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>112 bit</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>128 bit</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>192 bit</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>256 bit</string>
          </property>
         </item>
        </widget>
       </item>
       <item row="2" column="0">
        <widget class="QLabel" name="authPkgListLabel">
         <property name="text">
          <string>Authentication packages:</string>
         </property>
         <property name="toolTip">
          <string>Checked packages may be used during CredSSP/NLA negotiation; unchecked packages are explicitly forbidden. For Kerberos-only authentication (e.g. Active Directory Protected Users accounts), uncheck NTLM.</string>
         </property>
        </widget>
       </item>
       <item row="2" column="1">
        <layout class="QHBoxLayout" name="authPkgLayout">
         <item>
          <widget class="QCheckBox" name="kcfg_AuthPkgKerberos">
           <property name="text">
            <string>Kerberos</string>
           </property>
           <property name="toolTip">
            <string>Checked packages may be used during CredSSP/NLA negotiation; unchecked packages are explicitly forbidden. For Kerberos-only authentication (e.g. Active Directory Protected Users accounts), uncheck NTLM.</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="kcfg_AuthPkgNtlm">
           <property name="text">
            <string>NTLM</string>
           </property>
           <property name="toolTip">
            <string>Checked packages may be used during CredSSP/NLA negotiation; unchecked packages are explicitly forbidden. For Kerberos-only authentication (e.g. Active Directory Protected Users accounts), uncheck NTLM.</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="kcfg_AuthPkgU2u">
           <property name="text">
            <string>U2U</string>
           </property>
           <property name="toolTip">
            <string>Checked packages may be used during CredSSP/NLA negotiation; unchecked packages are explicitly forbidden. For Kerberos-only authentication (e.g. Active Directory Protected Users accounts), uncheck NTLM.</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="authPkgSpacer">
           <property name="orientation">
            <enum>Qt::Orientation::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
  </layout>
 </widget>
